<Page x:Class="ByeCompany.Pages.QuickTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="QuickTestPage">

    <Grid Background="White" Margin="20">
        <DockPanel LastChildFill="True">
            <!-- 상단 바: 뒤로가기 + 제목 -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10">
                <Button Content="←" Width="40" Height="30" Click="Back_Click"/>
                <TextBlock Text="나의 번아웃 상태는?" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 본문 영역 -->
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

                    <TextBlock Text="요즘 아침에 일어나기 힘든가요?" Margin="0,10"/>
                    <ComboBox x:Name="q1" Width="200">
                        <ComboBoxItem Content="그렇다"/>
                        <ComboBoxItem Content="보통이다"/>
                        <ComboBoxItem Content="아니다"/>
                    </ComboBox>

                    <TextBlock Text="일할 때 의욕이 부족한가요?" Margin="0,10"/>
                    <ComboBox x:Name="q2" Width="200">
                        <ComboBoxItem Content="그렇다"/>
                        <ComboBoxItem Content="보통이다"/>
                        <ComboBoxItem Content="아니다"/>
                    </ComboBox>

                    <TextBlock Text="미래에 대한 불안감이 큰가요?" Margin="0,10"/>
                    <ComboBox x:Name="q3" Width="200">
                        <ComboBoxItem Content="그렇다"/>
                        <ComboBoxItem Content="보통이다"/>
                        <ComboBoxItem Content="아니다"/>
                    </ComboBox>

                    <Button Content="결과 보기" Width="200" Margin="0,20" Click="Submit_Click"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
