<Page x:Class="ByeCompany.login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="login">
    <!--모서리를 둥글게하기위해 만듬 로그인, 얼굴인식 버튼에 사용 -->
    <Page.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="White">
        <!-- 🟦 파란 곡선 배경 -->
        <Canvas Height="600" Panel.ZIndex="0">
            <Path Fill="#004A91" Stretch="Fill"
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="0,300" />
                            <QuadraticBezierSegment Point1="250,400" Point2="400,300" />
                            <QuadraticBezierSegment Point1="600,200" Point2="800,300" />
                            <LineSegment Point="800,0" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- 🚀 로고 -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" Panel.ZIndex="1">
            <Image Source="images/logo.png" Width="200" Height="200" />
        </StackPanel>

        <!-- 🧾 로그인 박스 -->
        <Border Background="White"
                CornerRadius="30"
                Margin="0,240,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="300"
                Height="300"
                Padding="15"
                Panel.ZIndex="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Color="Gray" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="아이디" Margin="0,8,0,8" FontSize="12"/>
                <TextBox Name="IdTextBox" Height="28"/>

                <TextBlock Text="비밀번호" Margin="0,8,0,8" FontSize="12"/>
                <PasswordBox Name="PasswordBox" Height="28"/>

                <Button Content="얼굴인식"
                    Height="28"
                    Margin="0,8,0,2"
                    FontSize="13"
                    Click="FaceDetectButton_Click"
                    Background="LightGray"
                    Style="{StaticResource RoundedButtonStyle}" />

                <Button Content="로그인"
                    Background="#004A91"
                    Margin="0,8,0,8"
                    Foreground="White"
                    Height="35"
                    FontSize="18"
                    Style="{StaticResource RoundedButtonStyle}" />


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="회원가입" Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="12"/>
                    <TextBlock Text=" | " VerticalAlignment="Center" Foreground="Gray"/>
                    <Button Content="비밀번호 찾기" Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
