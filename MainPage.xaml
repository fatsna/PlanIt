<Page x:Class="ByeCompany.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ByeCompany.Components"
      Title="MainPage">

    <Grid x:Name="RootGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- 상단 전체 -->
            <RowDefinition Height="Auto"/>
            <!-- 네비게이션 -->
        </Grid.RowDefinitions>

        <!-- ✅ 상단 전체: 파란 배경 + 로고 + 문구 + 카드 -->
        <Grid Grid.Row="0">
            <!-- 파란 배경 -->
            <Border Background="#00478F"/>

            <!-- 로고 + 설명 문구 -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Image Source="pack://application:,,,/LOGO2.png"
                       Width="300" Stretch="Uniform" Margin="0,0,0,10"/>
                <TextBlock Text="PLANIT는 이직을 고민하는 사람에게"
                           FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="그 다음 인생을 설계하고 살아가는 힘을 주는 플랫폼입니다."
                           FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 카드 박스 (파란 배경 위에 떠있는 형태) -->
            <Border Margin="40,200,40,0" Padding="20"
                    CornerRadius="30" Background="White"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="5" Color="Gray"/>
                </Border.Effect>

                <UniformGrid Columns="3" Rows="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                    <!-- 감정분석 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border CornerRadius="25" Width="50" Height="50" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Button Click="EmotionAnalysis_Click" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="❤️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>
                        <TextBlock Text="감정분석" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 재정분석 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border CornerRadius="25" Width="50" Height="50" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Button Click="FinanceAnalysis_Click" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>
                        <TextBlock Text="재정분석" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 경력분석 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border CornerRadius="25" Width="50" Height="50" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Button Click="CareerAnalysis_Click" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>
                        <TextBlock Text="경력분석" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 지도 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border CornerRadius="25" Width="50" Height="50" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Button Click="Map_Click" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="🗺️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>
                        <TextBlock Text="지도" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 정밀테스트 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border CornerRadius="25" Width="50" Height="50" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Button Click="QuickTest_Click" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="🧠" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>
                        <TextBlock Text="정밀테스트" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 고용24 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border CornerRadius="25" Width="50" Height="50" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Button Click="Work24_Click" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="24" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Border>
                        <TextBlock Text="고용24" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>

        <!-- ✅ 하단 네비게이션 -->
        <local:BottomNav Grid.Row="1"/>
    </Grid>
</Page>
