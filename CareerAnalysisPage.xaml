<Page x:Class="ByeCompany.CareerAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CareerAnalysisPage">

    <Grid Background="White" Margin="20">
        <StackPanel Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="경력 분석" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />

            <!-- 현재 직무 -->
            <TextBlock Text="현재 직무" Margin="0,0,0,5"/>
            <TextBox x:Name="PositionTextBox" Margin="0,0,0,10"/>

            <!-- 경력 연수 -->
            <TextBlock Text="경력 연수" Margin="0,0,0,5"/>
            <ComboBox x:Name="ExperienceComboBox" Margin="0,0,0,10">
                <ComboBoxItem Content="1년 미만"/>
                <ComboBoxItem Content="1~3년"/>
                <ComboBoxItem Content="3~5년"/>
                <ComboBoxItem Content="5~10년"/>
                <ComboBoxItem Content="10년 이상"/>
            </ComboBox>

            <!-- 기술/자격증 -->
            <TextBlock Text="기술/자격증 (쉼표로 구분)" Margin="0,0,0,5"/>
            <TextBox x:Name="SkillsTextBox" Margin="0,0,0,10"/>

            <!-- 관심 산업 분야 -->
            <TextBlock Text="관심 산업 분야" Margin="0,0,0,5"/>
            <StackPanel x:Name="InterestPanel" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox Content="공공" Tag="공공" Margin="0,0,10,0"/>
                <CheckBox Content="헬스케어" Tag="헬스케어" Margin="0,0,10,0"/>
                <CheckBox Content="핀테크" Tag="핀테크" Margin="0,0,10,0"/>
                <CheckBox Content="게임" Tag="게임" Margin="0,0,10,0"/>
                <CheckBox Content="제조" Tag="제조"/>
            </StackPanel>

            <!-- 분석 버튼 -->
            <Button Content="분석하기" Click="AnalyzeButton_Click"
                    Background="#4A90E2" Foreground="White" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Page>
