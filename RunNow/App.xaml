<Application x:Class="RunNow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RunNow.Converters"
             xmlns:vm="clr-namespace:RunNow.ViewModels"
             xmlns:views="clr-namespace:RunNow.Views">
    <Application.Resources>
        <ResourceDictionary>
            <converters:NumberFormatConverter x:Key="NumberFormatConverter"/>
            <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>

            <!-- ✅ Map 템플릿 매핑 -->
            <DataTemplate DataType="{x:Type vm:MapViewModel}">
                <views:MapView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
