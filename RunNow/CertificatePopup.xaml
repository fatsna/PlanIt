<Window x:Class="RunNow.View.CertificatePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자격증 검색" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <StackPanel Margin="10">
        <TextBox x:Name="SearchBox" Margin="0,0,0,10"
                 Text="자격증 검색"
                 Foreground="Gray"
                 GotFocus="SearchBox_GotFocus"
                 LostFocus="SearchBox_LostFocus"/>

        <ListBox x:Name="CertificateListBox" Height="180" DisplayMemberPath="name"/>

        <Button Content="선택" HorizontalAlignment="Right" Width="80"
                Click="ConfirmButton_Click"/>
    </StackPanel>
</Window>
