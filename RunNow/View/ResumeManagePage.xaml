<Page x:Class="RunNow.View.ResumeManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ByeCompany.Components"
      Title="ResumeManagePage">

    <Grid Background="#00478F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단 타이틀 -->
            <RowDefinition Height="*"/>
            <!-- 본문 내용 -->
            <RowDefinition Height="Auto"/>
            <!-- BottomNav -->
        </Grid.RowDefinitions>

        <!-- 상단 타이틀 -->
        <StackPanel Grid.Row="0" Margin="0,30,0,20" HorizontalAlignment="Center">
            <TextBlock Text="이력서 관리 ✈️" 
                       FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 본문 카드 -->
        <Border Grid.Row="1" Margin="30,0,30,10" Padding="20" CornerRadius="30" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 프로필 이미지 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Ellipse Width="80" Height="80" Stroke="#CCC" StrokeThickness="1" Margin="0,10">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="pack://application:,,,/user.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </StackPanel>

                    <!-- 기본 정보 입력 -->
                    <StackPanel Margin="10" Orientation="Vertical">
                        <TextBlock Text="이름" FontWeight="Bold"/>
                        <TextBox x:Name="NameBox" Margin="0,3,0,10" Height="25"/>

                        
                        <!--  생년월일 선택 -->
                        <TextBlock Text="생년월일" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10" HorizontalAlignment="Left">
                            <ComboBox x:Name="YearBox" Width="80" Margin="0,0,10,0"/>
                            <ComboBox x:Name="MonthBox" Width="60" Margin="0,0,10,0"/>
                            <ComboBox x:Name="DayBox" Width="60"/>
                        </StackPanel>

                        <TextBlock Text="E-mail" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                            <!-- 이메일 아이디 입력 -->
                            <TextBox x:Name="EmailIdBox" Width="150" Height="25"/>

                            <TextBlock Text="@" VerticalAlignment="Center" Margin="5,0"/>

                            <!-- 도메인 선택 -->
                            <ComboBox x:Name="EmailDomainBox" Width="150" Height="30">
                                <ComboBoxItem Content="naver.com"/>
                                <ComboBoxItem Content="hanmail.net"/>
                                <ComboBoxItem Content="gmail.com"/>
                                <ComboBoxItem Content="nate.com"/>
                                <ComboBoxItem Content="kakao.com"/>
                                <ComboBoxItem Content="icloud.com"/>
                                <ComboBoxItem Content="outlook.com"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- 전번 -->
                        <TextBlock Text="전화번호" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10" VerticalAlignment="Center">
                            <!-- 앞자리 콤보박스 -->
                            <ComboBox x:Name="PhonePrefixBox" Width="70" Margin="0,0,5,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="010"/>
                                <ComboBoxItem Content="011"/>
                                <ComboBoxItem Content="016"/>
                                <ComboBoxItem Content="017"/>
                                <ComboBoxItem Content="018"/>
                                <ComboBoxItem Content="019"/>
                            </ComboBox>

                            <!-- 첫 번째 하이픈 -->
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,5,0"/>

                            <!-- 중간 4자리 -->
                            <TextBox x:Name="PhoneMidBox" Width="80" MaxLength="4" Margin="0,0,5,0" VerticalAlignment="Center"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"/>

                            <!-- 두 번째 하이픈 -->
                            <TextBlock Text="-" VerticalAlignment="Center" Margin="0,0,5,0"/>

                            <!-- 마지막 4자리 -->
                            <TextBox x:Name="PhoneEndBox" Width="80" MaxLength="4" VerticalAlignment="Center"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"/>
                        </StackPanel>




                        <TextBlock Text="주소" FontWeight="Bold"/>
                        <TextBox x:Name="AddressBox" Margin="0,3,0,10" Height="25"/>
                    </StackPanel>

                    <!-- 경력사항 -->
                    <Border BorderBrush="#999" BorderThickness="1" CornerRadius="10" Margin="0,20,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="경력사항" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>
                            <TextBox x:Name="CareerBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 특이사항 -->
                    <Border BorderBrush="#999" BorderThickness="1" CornerRadius="10" Margin="0,10,0,10">
                        <StackPanel Margin="10">
                            <TextBlock Text="특이사항" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>
                            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 이력서 저장 버튼 -->
                    <Button Content="이력서 저장"
                    Background="#00478F"
                    Foreground="White"
                    FontWeight="Bold"
                    Height="40"
                    Margin="0,10,0,20"
                    HorizontalAlignment="Stretch"
                    Name="SaveResumeButton"
                    Click="SaveResumeButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>


        <!-- 하단 BottomNav -->
        <local:BottomNav Grid.Row="2"/>
    </Grid>
</Page>
