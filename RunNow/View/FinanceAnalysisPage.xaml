<Page x:Class="ByeCompany.Pages.FinanceAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="FinanceAnalysisPage">

    <Grid Background="White" Margin="20">
        <!-- 상단 바: 뒤로가기 버튼 + 제목 -->
        <DockPanel LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10">
                <Button Content="←" Width="40" Height="30" Click="Back_Click"/>
                <TextBlock Text="재정 분석" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 본문 영역 -->
            <Grid Margin="0,20,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <TextBlock Text="총 자산 (만원)" FontSize="16" Margin="0,5"/>
                    <TextBox x:Name="AssetsBox" Height="30" Margin="0,5"/>

                    <TextBlock Text="월 지출 (만원)" FontSize="16" Margin="10,10,0,5"/>
                    <TextBox x:Name="ExpenseBox" Height="30" Margin="0,5"/>

                    <Button Content="생존 가능 개월 수 계산" Margin="0,20" Height="40" Click="Calculate_Click"/>

                    <TextBlock x:Name="ResultText" FontSize="18" FontWeight="Bold" 
                               TextAlignment="Center" Foreground="DarkBlue" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Page>
