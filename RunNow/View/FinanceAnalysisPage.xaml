<Page x:Class="ByeCompany.Pages.FinanceAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ByeCompany.Components"
      Title="FinanceAnalysisPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 파란 배경 -->
        <Border Grid.Row="0" Background="#00478F" Padding="0,20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/LOGO2.png" Width="150" Height="50" Stretch="Uniform" Margin="0,0,0,40"/>
            </StackPanel>
        </Border>

        <!-- 카드 박스 (입력 + 결과) -->
        <Border Grid.Row="1" Margin="30,-40,30,10" Padding="20" Background="White" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="Gray"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="500" HorizontalAlignment="Center">
                    <!-- 입력 항목 -->
                    <TextBlock Text="총 자산 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="18"/>
                    <TextBox x:Name="AssetsBox" Margin="0,0,0,10" Height="30" FontSize="16"
         PreviewTextInput="NumberBox_PreviewTextInput"
         TextChanged="NumberBox_TextChanged"
         DataObject.Pasting="NumberBox_Pasting"/>

                    <TextBlock Text="월 수입 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="18"/>
                    <TextBox x:Name="IncomeBox" Margin="0,0,0,10" Height="30" FontSize="16"
                         PreviewTextInput="NumberBox_PreviewTextInput"
                         TextChanged="NumberBox_TextChanged"
                         DataObject.Pasting="NumberBox_Pasting"/>

                    <TextBlock Text="고정 지출 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="18"/>
                    <TextBox x:Name="FixedExpenseBox" Margin="0,0,0,10" Height="30" FontSize="16"
                         PreviewTextInput="NumberBox_PreviewTextInput"
                         TextChanged="NumberBox_TextChanged"
                         DataObject.Pasting="NumberBox_Pasting"/>

                    <TextBlock Text="변동 지출 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="18"/>
                    <TextBox x:Name="VariableExpenseBox" Margin="0,0,0,10" Height="30" FontSize="16"
                         PreviewTextInput="NumberBox_PreviewTextInput"
                         TextChanged="NumberBox_TextChanged"
                         DataObject.Pasting="NumberBox_Pasting"/>

                    <!-- 버튼 -->
                    <Button Content="재정 분석 시작" Click="Calculate_Click"
                        Background="#00478F" Foreground="White" FontWeight="Bold"
                        FontSize="18" Height="38" Padding="12,6" Margin="0,20,0,0"/>

                    <!-- 분석 결과 -->
                    <StackPanel Margin="0,30,0,0">
                        <TextBlock Text="분석 결과" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="SurvivalMonthText" FontSize="19" Foreground="DarkGreen"/>
                        <TextBlock x:Name="SavingAmountText" FontSize="19" Foreground="DarkSlateBlue"/>
                        <TextBlock x:Name="WarningText" FontSize="19" Foreground="Red"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 하단 고정 네비게이션 -->
        <local:BottomNav Grid.Row="2"/>
    </Grid>
</Page>
