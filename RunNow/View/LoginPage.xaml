<Page x:Class="PlanIt.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginPage">

    <Page.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="White">
        <!-- Background Curve -->
        <Canvas VerticalAlignment="Top" Height="530" Panel.ZIndex="0">
            <Path Fill="#004A91" Stretch="Fill"
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="0,530" />
                            <QuadraticBezierSegment Point1="300,630" Point2="500,530" />
                            <QuadraticBezierSegment Point1="700,430" Point2="1000,530" />
                            <LineSegment Point="1000,0" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- Logo -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Image Source="../logo.png" Width="300" Height="300" />
        </StackPanel>

        <!-- Login Box -->
        <Border Background="White"
                CornerRadius="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,100,0,0"
                Width="420"
                Height="480"
                Padding="25"
                Panel.ZIndex="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="5" Color="Gray" />
            </Border.Effect>

            <StackPanel>
                <!-- 아이디 -->
                <TextBlock Text="아이디" Margin="0,10,0,6" FontSize="16"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontSize="17"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Left"/>

                <!-- 비밀번호 -->
                <TextBlock Text="비밀번호" Margin="0,14,0,6" FontSize="16"/>
                <PasswordBox x:Name="PasswordBox"
                            Height="40"
                            FontSize="17"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Left"/>

                <!-- Main Buttons -->
                <StackPanel Margin="0,20,0,0">
                    <Button Content="얼굴인식"
                            Height="50"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="#007ACC"
                            Foreground="White"
                            Click="FaceRecognition_Click"/>

                    <Button Content="로그인"
                            Height="60"
                            Margin="0,10,0,0"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="#004A91"
                            Foreground="White"
                            Command="{Binding LoginCommand}"/>
                </StackPanel>

                <!-- Extra options -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="회원가입"
                               Foreground="Gray"
                               Margin="0,0,20,0"
                               Cursor="Hand"
                               MouseLeftButtonDown="Register_Click"/>
                    <TextBlock Text="비밀번호 찾기"
                               Foreground="Gray"
                               Cursor="Hand"
                               MouseLeftButtonDown="FindPassword_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 얼굴 인식 팝업 -->
        <!-- 얼굴 인식 팝업 -->
        <Border x:Name="FacePopup"
        Visibility="Collapsed"
        Background="#DDFFFFFF"
        CornerRadius="16"
        Width="200"
        Height="200"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,30,0,0"
        Panel.ZIndex="99">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PopupImage" Width="80" Height="80" Margin="0,10,0,10"/>
                <TextBlock x:Name="PopupText"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="Black"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
