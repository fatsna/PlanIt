<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 버튼스타일정의 -->
     <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="SlateGray"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="50"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <!-- 그림자 효과 추가 -->
                        <Border.Effect>
                            <DropShadowEffect 
                            Color="Black" 
                            ShadowDepth="5" 
                            BlurRadius="10" 
                            Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonStyleRound" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="SlateGray"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Colors -->
    <SolidColorBrush x:Key="BrandBlue" Color="#174E9E"/>
    <SolidColorBrush x:Key="LineGrey"  Color="#E1E7F0"/>
    <SolidColorBrush x:Key="ChipBgBlue" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="ChipBgBeige" Color="#FFF3E6"/>

    <!-- 카드 공통 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrandBlue}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- 얇은 진행바 -->
    <Style TargetType="ProgressBar" x:Key="ThinBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="#E8ECF2"/>
        <Setter Property="Foreground" Value="#1F5FBF"/>
        <Setter Property="Maximum" Value="1"/>
    </Style>
</ResourceDictionary>