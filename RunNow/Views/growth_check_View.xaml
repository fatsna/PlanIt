<UserControl x:Class="RunNow.Views.growth_check_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RunNow.Views"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="760"
      Background="White"
      FontFamily="Noto sans KR"
      xmlns:lowbar="clr-namespace:RunNow.Views"
      >
<UserControl.Resources>
    <CollectionViewSource x:Key="GoalsView" Source="{Binding Goals}">
        <CollectionViewSource.GroupDescriptions>
            <PropertyGroupDescription PropertyName="Category"/>
        </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
</UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 상단 타이틀 -->
            <Image Source="/Assets/뒤로가기파랑.drawio.png"
                     HorizontalAlignment="Left"
                     Margin="10,10,0,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding BackCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <TextBlock x:Name="TextBlock_title" Text="플래닛 채우기"
                   FontFamily="Noto sans KR"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="SlateGray"
                   Background="White"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   Width="400" Height="60"/>
            <Image Source="/Assets/sendblue.png"
                     HorizontalAlignment="Right"
                     Margin="10,10,30,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <Grid x:Name="Grid_button"
              Background="#00478F"
              Margin="0, 100, 0, 0">
                <Border
                    Grid.Row="0"
                    Margin="40,35,40,35"
                    Grid.Column="0"
                    Background="white"
                    BorderBrush ="black"
                    BorderThickness="5"
                    CornerRadius="50">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="Button_first"
                            Grid.Row="0"
                            Margin="0, 10, 10, 10"
                            Width="550"
                            FontWeight="Bold"                    
                            Height="80"
                            Content="달성한 목표를 달력에 표시해보세요!"
                            Command="{Binding CalendarCommand}"
                            FontSize="30"
                            BorderBrush="#708090"
                            BorderThickness="3"
                            Foreground="White"                    
                            Style="{StaticResource FlatButtonStyle}"
                            Background="#708090"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        <Border
                            Grid.Row="1"
                            Margin="0, 0, 0, 0"
                            Width="550"
                            Height="360"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="5"
                            CornerRadius="10">
                            <!--목표들 표시하기-->
                            <ItemsControl ItemsSource="{Binding Source={StaticResource GoalsView}}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="18"
                                                           Foreground="DarkBlue"
                                                           Margin="0,10,0,5"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock Text="{Binding Goal}" DockPanel.Dock="Left" Width="300"/>
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                            <Button x:Name="Button_third"
                            Grid.Row="2"
                            Margin="0, 10, 10, 0"
                            Width="550"
                            FontWeight="Bold"      
                            BorderBrush="#708090"
                            BorderThickness="3"
                            Foreground="#708090"  
                            Height="80"
                            Content="마이 플래닛"
                            Command="{Binding Make_PlanITCommand}"
                            FontSize="30"
                            Style="{StaticResource FlatButtonStyle}"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </Grid>

            <!-- 하단 네비게이션 -->
            <lowbar:BottomNav Grid.Row="2"/>
        </Grid>
        <!--달력!-->
        <Grid   x:Name="Grid_calendar"
       Visibility="{Binding shareDataService.IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 어두운 배경 -->
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectangleClickCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>

            <Border BorderBrush="AliceBlue"
           Background="White"
           BorderThickness="7"
           Margin="80, 20, 80, 300"
           >
                <Grid Margin="20, 0, 20, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 근무 통계 -->
                    <TextBlock Grid.Row="0" 
              Text="{Binding ScheduleSummaryText}" 
              HorizontalAlignment="Left" 
              VerticalAlignment="Center"
              FontSize="13"
              FontWeight="Bold"
              FontFamily="Noto Sans KR"
              Foreground="Black"/>

                    <!-- 월 표시 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="&lt;" Grid.Column="0"
               Command="{Binding PreviousMonthCommand}"
               Background="Transparent" BorderThickness="0" FontSize="16"/>

                        <TextBlock Text="{Binding CurrentMonthText}"
                  Grid.Column="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  FontWeight="Bold"
                  FontSize="24"
                  FontFamily="Noto Sans KR"/>

                        <Button Content="&gt;" Grid.Column="2"
               Command="{Binding NextMonthCommand}"
               Background="Transparent" BorderThickness="0" FontSize="16"/>
                    </Grid>

                    <!-- 요일 -->
                    <UniformGrid Grid.Row="3" Columns="7">
                        <TextBlock Text="일" HorizontalAlignment="Center" Foreground="Red" FontFamily="Noto Sans KR"/>
                        <TextBlock Text="월" HorizontalAlignment="Center" FontFamily="Noto Sans KR"/>
                        <TextBlock Text="화" HorizontalAlignment="Center" FontFamily="Noto Sans KR"/>
                        <TextBlock Text="수" HorizontalAlignment="Center" FontFamily="Noto Sans KR"/>
                        <TextBlock Text="목" HorizontalAlignment="Center" FontFamily="Noto Sans KR"/>
                        <TextBlock Text="금" HorizontalAlignment="Center" FontFamily="Noto Sans KR"/>
                        <TextBlock Text="토" HorizontalAlignment="Center" Foreground="Blue" FontFamily="Noto Sans KR"/>
                    </UniformGrid>

                    <!-- 달력 날짜 -->
                    <ItemsControl Grid.Row="4" 
                 ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.DayClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                       CommandParameter="{Binding}"
                       BorderThickness="0"
                       Background="Transparent"
                       Padding="0"
                       IsEnabled="{Binding IsWrited}">
                                    <Border 
                       BorderBrush="LightGray"
                       BorderThickness="0.5"
                       CornerRadius="1"
                       Background="Transparent">
                                        <Grid Width="110" Height="110">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding DayText}" 
                                      Grid.Row="0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="2,1,0,0" 
                                      FontSize="12"
                                      Foreground="Black"
                                      FontWeight="SemiBold" 
                                      FontFamily="Noto Sans KR"/>
                                            <TextBlock Text="{Binding Tmp}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,0" 
                                      Grid.Row="1"                                               
                                      FontSize="12"
                                      Foreground="Black"
                                      Background="Aqua"
                                      FontWeight="SemiBold" 
                                      FontFamily="Noto Sans KR"                                             
                                      />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.Margin>
                            <Thickness  Top="-10"
                       Bottom="10"/>
                        </ItemsControl.Margin>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
