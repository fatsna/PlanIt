<UserControl x:Class="RunNow.Views.growth_check_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RunNow.Views"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:lowbar="clr-namespace:RunNow.Views"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="760"
      Background="White"
      FontFamily="Noto Sans KR">

    <!-- ===== 리소스 ===== -->
    <UserControl.Resources>
        <!-- 목표 목록(Grouping) 유지 -->
        <CollectionViewSource x:Key="GoalsView" Source="{Binding shareDataService.Goals}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- 팔레트/스타일 -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#004A91"/>
        <SolidColorBrush x:Key="SoftBlueBg" Color="#F3F8FF"/>
        <SolidColorBrush x:Key="SoftBlueBorder" Color="#CCE0FF"/>
        <SolidColorBrush x:Key="TextMain" Color="#1F2937"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="5" Color="Gray"/>

        <!-- 원형 아이콘 버튼 -->
        <Style x:Key="CircularIconButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="22"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F5F8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E7EFFD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 프라이머리 둥근 버튼 -->
        <Style x:Key="PrimaryRoundedButton" TargetType="Button">
            <Setter Property="Height" Value="64"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="16" Background="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0A64B3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#084E8C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 세컨더리 둥근 버튼 -->
        <Style x:Key="SecondaryRoundedButton" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource SoftBlueBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E7EFFD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ===== 레이아웃 ===== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 영역: 파도 배경 + 헤더 + 카드 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 헤더 -->
                <RowDefinition Height="*"/>
                <!-- 카드 -->
            </Grid.RowDefinitions>

            <!-- 파도 배경 -->
            <Canvas Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Height="530"
                    Panel.ZIndex="0" IsHitTestVisible="False">
                <Path Fill="#004A91" Stretch="Fill"
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,0" IsClosed="True">
                                <LineSegment Point="0,530"/>
                                <QuadraticBezierSegment Point1="300,630" Point2="500,530"/>
                                <QuadraticBezierSegment Point1="700,430" Point2="1000,530"/>
                                <LineSegment Point="1000,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <!-- 헤더 (뒤로가기 + 중앙 타이틀 + 우측 액션) -->
            <Border Grid.Row="0" Background="Transparent" Padding="16,18" Panel.ZIndex="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 뒤로가기: 이미지 → 이모지 버튼 -->
                    <Button Style="{StaticResource CircularIconButton}"
                            Command="{Binding BackCommand}">
                        <TextBlock Text="←" FontSize="18"/>
                    </Button>

                    <!-- 중앙 타이틀: TextBlock_title 이름 유지 -->
                    <TextBlock x:Name="TextBlock_title"
                               Grid.Column="0" Grid.ColumnSpan="3"
                               Text="플래닛 채우기"
                               FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- 우측 액션(기능 없음) -->
                    <Button Grid.Column="2" Style="{StaticResource CircularIconButton}">
                        <TextBlock Text="✉" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 본문 카드: Grid_button 이름 유지 -->
            <Grid x:Name="Grid_button" Grid.Row="1" Panel.ZIndex="1">
                <Border Margin="20,16,20,20" Padding="28"
                        CornerRadius="30" Background="White" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 상단 안내 버튼 -->
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <!-- 리스트 카드 -->
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <!-- 하단 버튼 -->
                        </Grid.RowDefinitions>

                        <!-- 상단 안내(달력에 표시) : Button_first 이름/커맨드 유지 -->
                        <Button x:Name="Button_first"
                                Grid.Row="0"
                                Style="{StaticResource PrimaryRoundedButton}"
                                Command="{Binding CalendarCommand}">
                            <TextBlock Text="달성한 목표를 달력에 표시해보세요!"
                                       FontSize="20"/>
                        </Button>

                        <!-- 목표 리스트 박스 -->
                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="#D0D7E2" BorderThickness="1"
                                CornerRadius="20" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="8" Opacity="0.35"/>
                            </Border.Effect>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 그룹 헤더 + 항목 -->
                                    <ItemsControl ItemsSource="{Binding Source={StaticResource GoalsView}}" Margin="0,0,0,8">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="18" FontWeight="Bold"
                                                                   Foreground="{StaticResource PrimaryBlue}"
                                                                   Margin="0,12,0,6"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Goal}"
                                                               DockPanel.Dock="Left"
                                                               Foreground="{StaticResource TextMain}"
                                                               Width="320"/>
                                                    <TextBlock Text="{Binding Date, StringFormat=완료날짜 : {0}}"
                                                               Foreground="{Binding Date, Converter={StaticResource StatusToColorConverter}}"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 하단: 마이 플래닛 버튼(이름/커맨드 유지) -->
                        <Button x:Name="Button_third"
                                Grid.Row="4"
                                Style="{StaticResource SecondaryRoundedButton}"
                                Command="{Binding Make_PlanITCommand}">
                            <TextBlock Text="마이 플래닛" FontSize="20"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 하단 네비 -->
        <lowbar:BottomNav Grid.Row="1"/>

        <!-- ===== 오버레이 1: messageback (Gridndar 이름/바인딩 유지) ===== -->
        <Grid x:Name="Gridndar"
              Visibility="{Binding shareDataService.IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectangleClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>

            <local:messageback x:Name="messageback"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Padding="20">
                <local:messageback.LayoutTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                </local:messageback.LayoutTransform>
            </local:messageback>
        </Grid>

        <!-- ===== 오버레이 2: 달력 (Grid_calendar 이름/바인딩 유지) ===== -->
        <Grid x:Name="Grid_calendar"
              Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectangleClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>

            <Border Background="White"
                    BorderBrush="{StaticResource SoftBlueBorder}" BorderThickness="7"
                    CornerRadius="16" Margin="60,20,60,220" Effect="{StaticResource CardShadow}">
                <Grid Margin="20,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <!-- 통계 -->
                        <RowDefinition Height="56"/>
                        <!-- 월 네비 -->
                        <RowDefinition Height="12"/>
                        <!-- spacer -->
                        <RowDefinition Height="40"/>
                        <!-- 요일 -->
                        <RowDefinition Height="*"/>
                        <!-- 날짜 -->
                    </Grid.RowDefinitions>

                    <!-- 통계 -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding ScheduleSummaryText}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"
                               VerticalAlignment="Center"/>

                    <!-- 월 네비게이션 (이전/현재/다음) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource CircularIconButton}"
                                Command="{Binding PreviousMonthCommand}">
                            <TextBlock Text="←" FontSize="18"/>
                        </Button>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentMonthText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="22"/>

                        <Button Grid.Column="2" Style="{StaticResource CircularIconButton}"
                                Command="{Binding NextMonthCommand}">
                            <TextBlock Text="→" FontSize="18"/>
                        </Button>
                    </Grid>

                    <!-- 요일 -->
                    <UniformGrid Grid.Row="3" Columns="7">
                        <TextBlock Text="일" HorizontalAlignment="Center" Foreground="Red"/>
                        <TextBlock Text="월" HorizontalAlignment="Center"/>
                        <TextBlock Text="화" HorizontalAlignment="Center"/>
                        <TextBlock Text="수" HorizontalAlignment="Center"/>
                        <TextBlock Text="목" HorizontalAlignment="Center"/>
                        <TextBlock Text="금" HorizontalAlignment="Center"/>
                        <TextBlock Text="토" HorizontalAlignment="Center" Foreground="Blue"/>
                    </UniformGrid>

                    <!-- 날짜 -->
                    <ItemsControl Grid.Row="4" Margin="0,0,0,10" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.DayClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        BorderThickness="0" Background="Transparent" Padding="0"
                                        IsEnabled="{Binding IsWrited}">
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Background="Transparent" Margin="2">
                                        <Grid Width="104" Height="96">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding DayText}"
                                                       Margin="6,4,0,0"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       FontSize="12" FontWeight="SemiBold"/>

                                            <TextBlock Grid.Row="1" Text="{Binding Tmp}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Background="#EAF2FF"
                                                       Foreground="{StaticResource PrimaryBlue}"
                                                       Padding="4,2"
                                                       Visibility="{Binding DayVisibility}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 오버레이 3: Goals 팝업(이름/바인딩 유지) ===== -->
        <Grid Visibility="{Binding Popup, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="110">
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectanglePupupCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>

            <Grid>
                <Border CornerRadius="20"
                        BorderBrush="{StaticResource SoftBlueBorder}" BorderThickness="5"
                        Margin="120,100,120,180"
                        Background="White" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- 타이틀 줄 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 카테고리 버튼들 -->
                            <RowDefinition Height="*"/>
                            <!-- 진행중 목록 -->
                            <RowDefinition Height="Auto"/>
                            <!-- Completed 헤더 -->
                            <RowDefinition Height="*"/>
                            <!-- 완료 목록 -->
                            <RowDefinition Height="Auto"/>
                            <!-- 완료 버튼 -->
                        </Grid.RowDefinitions>

                        <!-- 타이틀: 뒤로/제목/닫기 -->
                        <Grid Grid.Row="0" Margin="8,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource CircularIconButton}"
                                    Command="{Binding RectanglePupupCommand}">
                                <TextBlock Text="←" FontSize="16"/>
                            </Button>

                            <TextBlock Grid.Column="1" Text="Goals"
                                       FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Button Grid.Column="2" Style="{StaticResource CircularIconButton}"
                                    Command="{Binding RectanglePupupCommand}">
                                <TextBlock Text="✖" FontSize="16"/>
                            </Button>
                        </Grid>

                        <!-- 카테고리 버튼들 (Border+Trigger 유지, 아이콘은 이모지) -->
                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 자격증 -->
                            <Border Grid.Column="0" CornerRadius="12"
                                    BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2"
                                    Margin="6" Padding="10">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDown">
                                        <i:InvokeCommandAction Command="{Binding Show_GoalsCommand}" CommandParameter="자격증"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🎓" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="자격증" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 기술 -->
                            <Border Grid.Column="1" CornerRadius="12"
                                    BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2"
                                    Margin="6" Padding="10">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDown">
                                        <i:InvokeCommandAction Command="{Binding Show_GoalsCommand}" CommandParameter="기술"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛠️" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="기술" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 경험 -->
                            <Border Grid.Column="2" CornerRadius="12"
                                    BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="2"
                                    Margin="6" Padding="10">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDown">
                                        <i:InvokeCommandAction Command="{Binding Show_GoalsCommand}" CommandParameter="경험"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🧪" FontSize="28" HorizontalAlignment="Center"/>
                                    <TextBlock Text="경험" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 진행 중 목록 -->
                        <Border Grid.Row="2" CornerRadius="14" Margin="8"
                                Background="{StaticResource SoftBlueBg}"
                                BorderBrush="{StaticResource SoftBlueBorder}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <ItemsControl ItemsSource="{Binding GoalsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Command="{Binding DataContext.ToggleSelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"
                                                          Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Card" CornerRadius="12" Margin="6,2"
                                                                BorderBrush="#A0B8FF" BorderThickness="2" Padding="10"
                                                                Background="#EEF4FF">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Goal}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                                                <Border Grid.Column="1" Background="#DDE8FF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Top">
                                                                    <TextBlock Text="{Binding Importance}" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Card" Property="Background" Value="#E7F0FF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="#2E86FF"/>
                                                                <Setter TargetName="Card" Property="Background" Value="#DDE8FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Completed 헤더 -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                            <TextBlock Text="🏆" FontSize="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Completed Goals" FontWeight="Bold" FontSize="17"/>
                        </StackPanel>

                        <!-- 완료 목록 -->
                        <Border Grid.Row="4" CornerRadius="14" Margin="8"
                                Background="#FFF5F5" BorderBrush="#FFC8C8" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <ItemsControl ItemsSource="{Binding CompleteGoals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Margin="6,2"
                                                    BorderBrush="#FFC08A" BorderThickness="2" Padding="10" Background="#FFFAF3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Goal}" FontWeight="Bold" FontSize="13" Foreground="#6B4E16"/>
                                                    <Border Grid.Column="1" Background="#FFEAD2" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Importance}" FontWeight="Bold" Foreground="#6B4E16"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 완료 처리 버튼 -->
                        <Button Grid.Row="5" Style="{StaticResource PrimaryRoundedButton}"
                                Command="{Binding Goal_finishCommand}" Margin="8,0,8,10" Background="#0E7C66">
                            <TextBlock Text="Complete!!" FontSize="18"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <!--백프로!!-->
        <Grid Visibility="{Binding GOAL, Converter={StaticResource BoolToVisibilityConverter}}">
            <lowbar:Goal>
                
            </lowbar:Goal>
        </Grid>
        
    </Grid>
</UserControl>
