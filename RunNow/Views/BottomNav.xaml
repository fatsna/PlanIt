<UserControl x:Class="RunNow.Views.BottomNav"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="400">

    <Grid>
        <!-- 배경 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 위쪽 흰 배경 -->
        <Rectangle Fill="White" Height="40" VerticalAlignment="Top"/>

        <!-- 하단 네비게이션 -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="0,30,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 메뉴 1 -->

                <Button Grid.Column="0"
                        Background="Transparent"
                        Command="{Binding DataContext.PlanitCommand , RelativeSource={RelativeSource AncestorType=Window}}"
                        BorderThickness="0"
                        Margin="0,0,0,0">
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="성장플래닛" FontSize="12" Foreground="#444" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>


                <!-- 메뉴 2 -->
                <Button Grid.Column="1"
                        Command="{Binding DataContext.ChatBotCommand , RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                             Text="&#xE720;"
                             FontSize="16"
                             HorizontalAlignment="Center"/>
                        <TextBlock Text="챗봇상담"
                             FontSize="12"
                             Foreground="#444"
                             HorizontalAlignment="Center"
                             Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <!-- 메뉴 3 -->
                <Button Grid.Column="2"
                        Command="{Binding DataContext.ResumeManageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE8A5;"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
                        <TextBlock Text="이력서관리"
                           FontSize="12"
                           Foreground="#444"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>


                <!-- 메뉴 4 -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="마이페이지" FontSize="12" Foreground="#444" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 홈 버튼 (중앙 원형, 클릭 시 MainView로 이동) -->
        <Button Width="70" Height="70"
        Command="{Binding DataContext.GoHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        Grid.RowSpan="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="#00478F"
        BorderThickness="2"
        BorderBrush="White" Click="Button_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="35"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>

            <TextBlock FontFamily="Segoe MDL2 Assets"
               Text="&#xE80F;"
               Foreground="White"
               FontSize="28"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
        </Button>

    </Grid>
</UserControl>
