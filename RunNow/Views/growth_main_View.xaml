<UserControl x:Class="RunNow.Views.growth_main_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:RunNow.Views"
             xmlns:lowbar="clr-namespace:RunNow.Views"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="760"
             Background="White"
             FontFamily="Noto sans KR">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <!-- 상단 헤더 -->
            <RowDefinition Height="Auto"/>
            <!-- 메인(카드) -->
            <RowDefinition Height="*"/>
            <!-- 하단 네비 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 파도 배경 (헤더+메인 영역 뒤) -->
        <Canvas Grid.Row="0" Grid.RowSpan="2"
                VerticalAlignment="Top"
                Height="530"
                IsHitTestVisible="False"
                Panel.ZIndex="0">
            <Path Fill="#004A91" Stretch="Fill"
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="0,530" />
                            <QuadraticBezierSegment Point1="300,630" Point2="500,530" />
                            <QuadraticBezierSegment Point1="700,430" Point2="1000,530" />
                            <LineSegment Point="1000,0" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- 상단 투명 헤더 -->
        <Border Grid.Row="0" Background="Transparent" Padding="0,12" Panel.ZIndex="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 뒤로가기 -->
                <Image Source="/Assets/뒤로가기파랑.drawio.png"
               Width="50" Height="50"
               Margin="10,0,0,10"
               HorizontalAlignment="Left" VerticalAlignment="Center"
               Cursor="Hand">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDown">
                            <i:InvokeCommandAction Command="{Binding BackCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Image>

                <!-- 중앙 타이틀: 3컬럼 span으로 항상 정중앙 -->
                <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                   Text="성장플래닛"
                   FontSize="35"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
            </Grid>
        </Border>


        <!-- 메인 카드 -->
        <Border Grid.Row="1"
                Margin="50,50,50,40"
                Padding="24"
                Background="White"
                CornerRadius="20"
                Panel.ZIndex="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="Gray"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="500" HorizontalAlignment="Center">
                    <!-- 타이틀 -->
                    <TextBlock x:Name="TextBlock_title"
                               Text="MEMU"
                               FontSize="32" FontWeight="Bold"
                               Foreground="SlateGray"
                               TextAlignment="Center"
                               Margin="0,5,0,70"/>

                    <!-- 버튼 3종 : 기존 바인딩/이름/스타일 유지 -->
                    <Button x:Name="Button_EmotionAnalysis"
                            Command="{Binding Planit_startCommand}"
                            Content="플래닛 시작"
                            Width="500" Height="80"
                            Margin="0,0,0,50"
                            FontSize="24"
                            Foreground="Black"
                            Background="White"
                            Style="{StaticResource FlatButtonStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"/>

                    <Button x:Name="Button_second"
                            Command="{Binding Planit_checkCommand}"
                            Content="플래닛 채우기"
                            Width="500" Height="80"
                            Margin="0,0,0,50"
                            FontSize="24"
                            Foreground="Black"
                            Style="{StaticResource FlatButtonStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"/>

                    <Button x:Name="Button_third"
                            Command="{Binding Planit_MyCommand}"
                            Content="마이 플래닛"
                            Width="500" Height="80"
                            Margin="0,0,0,10"
                            FontSize="24"
                            Foreground="Black"
                            Style="{StaticResource FlatButtonStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 하단 네비게이션 -->
        <lowbar:BottomNav Grid.Row="2" Panel.ZIndex="1"/>

        <!-- 딤 + 상세 모달 (기존 바인딩/이름/트리거 유지) -->
        <Grid x:Name="Grid_message_Deep"
              Panel.ZIndex="100"
              Visibility="{Binding shareDataService.IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 어두운 배경 -->
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectangleClickCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>

            <!-- 컨텐츠 -->
            <local:messageDeep x:Name="messagedeep"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Padding="20">
                <local:messageDeep.LayoutTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                </local:messageDeep.LayoutTransform>
            </local:messageDeep>
        </Grid>
    </Grid>
</UserControl>
