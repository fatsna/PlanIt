<UserControl x:Class="RunNow.Views.growth_main_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RunNow.Views"
      mc:Ignorable="d" 
      FontFamily="Noto sans KR"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"             
      d:DesignHeight="1000" d:DesignWidth="760"
      Background="White"
      xmlns:lowbar="clr-namespace:RunNow.Views"
      >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 상단 타이틀 -->
        <Image Source="pack://application:,,,/Assets/뒤로가기파랑.drawio.png"
                     HorizontalAlignment="Left"
                     Margin="10,10,0,0"
                     VerticalAlignment="Top"
                      Panel.ZIndex="100"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding BackCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Image>
        <TextBlock x:Name="TextBlock_title" Text="성장플래닛"
                   FontFamily="Noto sans KR"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="SlateGray"
                   Background="White"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   Width="400" Height="60"/>
        <Image Source="/Assets/sendblue.png"
                     HorizontalAlignment="Right"
                     Margin="10,10,30,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <!--무언가 커맨드해서 기능추가가능-->
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Image>
        <Grid x:Name="Grid_button"
              Background="#00478F"
              Margin="0, 100, 0, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="Button_EmotionAnalysis"
                    Command="{Binding Planit_startCommand}"
                    Grid.Row="0"
                    Margin="0, 10, 10, 10"
                    Width="500"
                    Height="80"
                    Content="플래닛 시작하기"
                    FontSize="30"
                    Foreground="SlateGray"                    
                    FontWeight="Bold"
                    Style="{StaticResource FlatButtonStyle}"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                        />
            <Button x:Name="Button_second"
                    Command="{Binding Planit_checkCommand}"
                    Grid.Row="1"
                    Margin="0, 10, 10, 10"
                    Width="500"
                    FontWeight="Bold"                    
                    Height="80"
                    Foreground="SlateGray"                   
                    Content="플래닛 채우기"
                    FontSize="30"
                    Style="{StaticResource FlatButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    />
            <Button x:Name="Button_third"
                    Grid.Row="2"           
                    Command="{Binding Planit_MyCommand}"                    
                    Width="500"
                    Height="80"
                    FontWeight="Bold"        
                    Foreground="SlateGray"                    
                    Content="마이 플래닛"
                    FontSize="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource FlatButtonStyle}"                        
                    />
            <Image Grid.Row="3"
                   Margin="0, 0, 0, 0"
                   Width="300"
                   Height="300"
                   Source="/Assets/logo.png">
            </Image>          
        </Grid>
        <!-- 하단 네비게이션 -->
        <lowbar:BottomNav Grid.Row="2"/>
    </Grid>
</UserControl>
