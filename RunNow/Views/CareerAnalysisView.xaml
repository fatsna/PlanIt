<UserControl x:Class="RunNow.Views.CareerAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local ="clr-namespace:RunNow.Views"
             mc:Ignorable="d">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 파란 배경 -->
        <Border Grid.Row="0" Background="#00478F" Padding="0,20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/LOGO2.png" Width="150" Height="50" Stretch="Uniform" Margin="0,0,0,40"/>
            </StackPanel>
        </Border>

        <!-- 카드 박스 -->
        <Border Grid.Row="1" Margin="30,-40,30,10" Padding="20" Background="White" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="Gray"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="260" HorizontalAlignment="Center">

                    <!-- 현재 직무 -->
                    <TextBlock Text="현재 직무" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding CurrentPosition, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <!-- 경력 연수 -->
                    <TextBlock Text="경력 연수" Margin="0,10,0,5" FontWeight="Bold"/>
                    <ComboBox SelectedItem="{Binding Experience}" Margin="0,0,0,10">
                        <ComboBoxItem Content="1년 미만"/>
                        <ComboBoxItem Content="1~3년"/>
                        <ComboBoxItem Content="3~5년"/>
                        <ComboBoxItem Content="5~10년"/>
                        <ComboBoxItem Content="10년 이상"/>
                    </ComboBox>

                    <!-- 기술 -->
                    <TextBlock Text="기술/자격증 (쉼표로 구분)" Margin="0,10,0,5" FontWeight="Bold"/>
                    <TextBox Text="{Binding Skills, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <!-- 관심 산업 분야 -->
                    <TextBlock Text="관심 산업 분야" Margin="0,10,0,5" FontWeight="Bold"/>

                    <!-- ✅ MVVM ItemsControl -->
                    <ItemsControl ItemsSource="{Binding InterestCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Category}" FontWeight="Bold" Margin="0,10,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" 
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      Margin="5,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!-- 분석 버튼 -->
                    <Button Content="분석하기"
                            Command="{Binding AnalyzeCommand}"
                            Background="#00478F" Foreground="White" FontWeight="Bold"
                            Padding="8,4" Margin="0,10,0,0"/>

                    <!-- 분석 결과 -->
                    <TextBlock Text="{Binding AnalysisResult}"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               Foreground="Black"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 하단 네비게이션 -->
        <local:BottomNav Grid.Row="2"/>
    </Grid>
</UserControl>
