<UserControl x:Class="RunNow.Views.messageDeep"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RunNow.Views"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DesignHeight="450" d:DesignWidth="800"
             FontFamily="Noto sans KR"
             Background="Transparent">
    <Grid>
        <Border x:Name="Border_main"
                    Grid.Row="0"
                    BorderBrush="#FE885C"
                    BorderThickness="3"
                    Margin="20"
                    Background="White"
                    CornerRadius="30"
                    Padding="20">
            <TextBlock Text="종합테스트 결과가 없습니다!!&#x0a;종합테스트를 먼저 진행해주세요!"
                       Margin="40"
                       FontSize="40"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#FE885C"
                       >
            </TextBlock>

        </Border>
        <Grid>
            <Border x:Name="Border_text"
                    Grid.Row="0"
                    BorderBrush="#FE885C"
                    BorderThickness="3"
                    Background="White"
                    Margin="50,-30, 500, 400"
                    CornerRadius="30"
                    Padding="20">
                <TextBlock Text="메 시 지"
                           FontSize="25"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           Foreground="#FE885C"
                           >
                </TextBlock>
            </Border>
        </Grid>
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Border_button"
                Grid.Row="0"
                BorderBrush="#FE885C"
                BorderThickness="3"
                Background="White"
                Margin="100,270, 100, 100"
                CornerRadius="10"
                Padding="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding DataContext.GoDeepCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="테스트 하러가기"
                               TextAlignment="Center"
                               Grid.Column="0"
                               FontSize="17"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"  
                                Foreground="#FE885C"
                               >
                    </TextBlock>
                    <Image Source="/Assets/체크버튼.drawio.png"
                           Grid.Column="1" 
                           Margin="0,0,10,0"
                            Width="30"
                            Height="30"
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            >
                    </Image>
                </Grid>
            </Border>
            <Border x:Name="Border_button2"
                Grid.Column="1"
                BorderBrush="#FE885C"
                BorderThickness="3"
                Background="White"
                Margin="100,270, 100, 100"
                CornerRadius="10"
                Padding="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding DataContext.MsgCloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="테스트는 다음에"
                               TextAlignment="Center"
                               Grid.Column="0"
                               FontSize="17"
                                                      Foreground="#FE885C"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"                               
                               >
                    </TextBlock>
                    <Image Source="/Assets/엑스버튼.drawio.png"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Width="30"
                       Height="30"
                       Grid.Row="0"
                       HorizontalAlignment="Right"
                       Grid.Column="1">
                    </Image>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
