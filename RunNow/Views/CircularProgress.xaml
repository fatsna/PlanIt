<UserControl x:Class="RunNow.Views.CircularProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root" Width="170" Height="170">
    <Grid>
        <!-- 배경 링 (고정 색상/굵기) -->
        <Ellipse Stroke="#E6EBF3" StrokeThickness="14"/>

        <!-- 진행 링(호). Path의 Data는 code-behind에서 계산/그려 넣음 -->
        <!-- Stroke는 앱 리소스(BrandBlue)를 사용 -->
        <Path x:Name="ArcPath"
              Stroke="{StaticResource BrandBlue}"
              StrokeThickness="14"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Fill="Transparent"/>

        <!-- 중앙 % 텍스트 -->
        <!-- root(=UserControl)의 AnimatedValue DP에 바인딩 -->
        <!-- StringFormat {0:P0} => 0.75 => 75% 로 표시 -->
        <TextBlock Text="{Binding ElementName=root, Path=AnimatedValue, StringFormat={}{0:P0}}"
                   FontSize="40" FontWeight="Bold" Foreground="#1E2B3C"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
