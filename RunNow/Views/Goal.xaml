<UserControl x:Class="RunNow.Views.Goal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RunNow.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid Background="#CC000000" />

        <Canvas x:Name="ConfettiCanvas" Background="Transparent" MouseDown="ConfettiCanvas_MouseDown">
            <TextBlock x:Name="MessageBlock"
                       Text="모든 목표 달성! 화면을 클릭해 축하해주세요!"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="White"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Canvas.Left="100" Canvas.Top="200"
                       Width="600" />
        </Canvas>

        <Button x:Name="CloseButton"
                Content="확인"
                Width="200"
                Height="50"
                FontSize="20"
                Background="#FF5722"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,50"
                Visibility="Collapsed"
                Click="CloseButton_Click"/>
    </Grid>
</UserControl>
