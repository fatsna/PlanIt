<UserControl x:Class="RunNow.Views.Growth_My_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RunNow.Views"
      mc:Ignorable="d" 
      xmlns:c="clr-namespace:RunNow.Converters"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      FontFamily="Noto sans KR"
      d:DesignHeight="1000" d:DesignWidth="760"
      Background="White"
      xmlns:lowbar="clr-namespace:RunNow.Views"
      >
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 상단 타이틀 -->
            <Image Source="/Assets/뒤로가기파랑.drawio.png"
                     HorizontalAlignment="Left"
                     Margin="10,10,0,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding BackCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <TextBlock x:Name="TextBlock_title" Text="마이 플래닛"
                   FontFamily="Noto sans KR"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="SlateGray"
                   Background="White"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   Width="400" Height="60"/>
            <Image Source="/Assets/sendblue.png"
                     HorizontalAlignment="Right"
                     Margin="10,10,30,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <!--무언가 커맨드해서 기능추가가능-->
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <Grid x:Name="Grid_button"
              Background="#00478F"
              Margin="0, 100, 0, 0">
                <Border
                    Grid.Row="0"
                    Margin="40,35,40,35"
                    Grid.Column="0"
                    Background="white"
                    BorderBrush ="black"
                    BorderThickness="5"
                    CornerRadius="50">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        <!-- 상단 카드 -->
                        <Border Style="{StaticResource Card}" Padding="16" 
                                Grid.Row="0"
                                Margin="10, 10, 10, 10"
                                CornerRadius ="40"
                                BorderBrush ="{StaticResource BrandBlue}"
                                BorderThickness="3"
                                >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 칩: 직업 / D-day -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Border Padding="12,6" 
                                                CornerRadius="16" 
                                                Background="{StaticResource ChipBgBlue}" 
                                                Margin="10,0, 0,0"                                                
                                                >
                                            <TextBlock Text="{Binding TargetJob}" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Padding="12,6" CornerRadius="16" Background="{StaticResource ChipBgBeige}" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding DaysLeft, StringFormat=남은기간 : D-{0}}" FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>

                                <!-- 원형 게이지 -->
                                <lowbar:CircularProgress Grid.Row="1" 
                                                         VerticalAlignment="Top"
                                                         HorizontalAlignment="Center" Margin="0,0,0,8"
                                                    Value="{Binding Progress}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Loaded">
                                            <i:InvokeCommandAction Command="{Binding CircularProgressLoadedCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </lowbar:CircularProgress>
                                <!-- 서브 메트릭 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding SubMetrics[0]}" Margin="0,0,18,0"
                                               FontSize="20"/>
                                    <TextBlock Text="{Binding SubMetrics[1]}" Margin="0,0,18,0"
                                               FontSize="20"/>
                                    <TextBlock Text="{Binding SubMetrics[2]}"
                                               FontSize="20"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Margin="0, 0, 0, 0"
                            Width="550"
                            Height="150"
                            VerticalAlignment="Bottom"
                            Background="White"
                            BorderBrush="#FE885C"
                            BorderThickness="5"
                            CornerRadius="10">
                            <TextBlock Text="{Binding NextGoal, StringFormat=다음목표는 {0} 어떠신가요?!}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20">

                            </TextBlock>
                        </Border>
                        <Button x:Name="Button_third"
                            Grid.Row="2"
                            Margin="0, 10, 10, 0"
                            Width="550"
                            BorderBrush="Black"
                            Command="{Binding GoTocheckCommand}"
                            BorderThickness="3"
                            Foreground="Black"  
                            Height="80"
                            Content="플래닛 채우기"
                            FontSize="30"
                            Style="{StaticResource FlatButtonStyle}"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid>
                    <Border
                         Margin="120, 40, 0, 0"
                         Width="140"
                         Height="70"
                         HorizontalAlignment="Left"
                         Background="White"
                         BorderBrush="#FE885C"
                         BorderThickness="5"
                         CornerRadius="10">
                        <TextBlock Text="Tip."
                                   TextAlignment="Center"
                                   FontSize="30"
                                   Foreground="#FE885C"
                                   />
                    </Border>
                </Grid>
            </Grid>
            <!-- 하단 네비게이션 -->
            <lowbar:BottomNav Grid.Row="2"/>
        </Grid>
        <!--두번쨰 레이아웃-->
        <Grid   x:Name="Grid_calendar"
            Visibility="{Binding shareDataService.IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 어두운 배경 -->
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectangleClickCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>
            <local:messageback x:Name="messageback"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0, 0, 0, 0"
                Background="Transparent"
                Padding="20">

                <local:messageback.LayoutTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                </local:messageback.LayoutTransform>
            </local:messageback>
        </Grid>
    </Grid>
</UserControl>
