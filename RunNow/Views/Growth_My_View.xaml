<UserControl x:Class="RunNow.Views.Growth_My_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RunNow.Views"
      mc:Ignorable="d" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      FontFamily="Noto sans KR"
      d:DesignHeight="1000" d:DesignWidth="760"
      Background="White"
      xmlns:lowbar="clr-namespace:RunNow.Views"
      >
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- 상단 타이틀 -->
            <Image Source="/Assets/뒤로가기파랑.drawio.png"
                     HorizontalAlignment="Left"
                     Margin="10,10,0,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding BackCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <TextBlock x:Name="TextBlock_title" Text="마이 플래닛"
                   FontFamily="Noto sans KR"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="SlateGray"
                   Background="White"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   Width="400" Height="60"/>
            <Image Source="/Assets/sendblue.png"
                     HorizontalAlignment="Right"
                     Margin="10,10,30,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <!--무언가 커맨드해서 기능추가가능-->
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
            <Grid x:Name="Grid_button"
              Background="#00478F"
              Margin="0, 100, 0, 0">
                <Border
                    Grid.Row="0"
                    Margin="40,35,40,35"
                    Grid.Column="0"
                    Background="white"
                    BorderBrush ="black"
                    BorderThickness="5"
                    CornerRadius="50">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        
                        <Border
                            Grid.Row="1"
                            Margin="0, 0, 0, 0"
                            Width="550"
                            Height="200"
                            VerticalAlignment="Bottom"
                            Background="White"
                            BorderBrush="#FE885C"
                            BorderThickness="5"
                            CornerRadius="10">
                        </Border>
                        <Button x:Name="Button_third"
                            Grid.Row="2"
                            Margin="0, 10, 10, 0"
                            Width="550"
                            FontWeight="Bold"      
                            BorderBrush="#708090"
                            Command="{Binding GoTocheckCommand}"
                            BorderThickness="3"
                            Foreground="#708090"  
                            Height="80"
                            Content="플래닛 채우기"
                            FontSize="30"
                            Style="{StaticResource FlatButtonStyle}"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid>
                    <Border
                         Margin="120, -30, 0, 0"
                         Width="140"
                         Height="70"
                         HorizontalAlignment="Left"
                         Background="White"
                         BorderBrush="#FE885C"
                         BorderThickness="5"
                         CornerRadius="10">
                        <TextBlock Text="Tip."
                                   TextAlignment="Center"
                                   FontSize="30"
                                   Foreground="#FE885C"
                                   />
                    </Border>
                </Grid>
            </Grid>

            <!-- 하단 네비게이션 -->
            <lowbar:BottomNav Grid.Row="2"/>
        </Grid>
    </Grid>
</UserControl>
