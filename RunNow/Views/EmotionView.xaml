<Page x:Class="RunNow.Views.EmotionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:RunNow.Converters"
      Background="#00478F">

    <Page.Resources>
        <conv:AnswerToColorConverter x:Key="AnswerColorConverters"/>
        <conv:QuestionAnswerParameterConverter x:Key="QuestionAnswerParameterConverter"/>
    </Page.Resources>


    <Grid>
        <!-- 상단 타이틀 -->
        <TextBlock x:Name="TextBlock_title" Text="감정분석"
                   FontFamily="Arial Black"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="AliceBlue"
                   Background="#00478F"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,27,0,0"
                   Width="400" Height="45"/>

        <!-- 질문 리스트 영역 -->
        <ScrollViewer Margin="0,80,0,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CurrentQuestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10">
                            <!-- 질문 카드 배경 -->
                            <Rectangle Height="100" Width="380"
                                       RadiusX="20" RadiusY="20"
                                       Stroke="Black" StrokeThickness="3"
                                       Fill="White"
                                       HorizontalAlignment="Center"/>

                            <!-- 질문 텍스트 -->
                            <TextBlock Text="{Binding QuestionText}"
                                       Foreground="#708090"
                                       FontSize="16"
                                       TextWrapping="Wrap"
                                       FontWeight="Bold"
                                       Width="350"
                                       Margin="0,-90,0,0"
                                       HorizontalAlignment="Center"/>

                            <!-- 답변 버튼 -->
                            <ItemsControl ItemsSource="{Binding Answers}"
                                          Margin="0,-50,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black"
                                                BorderThickness="2"
                                                Height="25"
                                                Width="60"
                                                Margin="4">
                                            <Button Content="{Binding}"
                                                    FontSize="8"
                                                    Foreground="#708090"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SelectAnswerCommand, RelativeSource={RelativeSource AncestorType=Page}}">

                                                                              <!-- ✅ 이 부분이 배경색을 결정합니다 -->
                                                    <Button.Background>
                                                        <MultiBinding Converter="{StaticResource AnswerColorConverters}">
                                                        <Binding Path="DataContext.SelectedAnswerIndex"
                                                                 RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=StackPanel}" />
                                                        <Binding />
                                                    </MultiBinding>
                                                    </Button.Background>

                                                                            <!-- 기존처럼 CommandParameter도 유지 -->
                                                    <Button.CommandParameter>
                                                        <MultiBinding Converter="{StaticResource QuestionAnswerParameterConverter}">
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </Button.CommandParameter>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
