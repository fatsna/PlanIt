<UserControl x:Class="RunNow.Views.DeepTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RunNow.Converters"
             xmlns:behaviors="clr-namespace:RunNow.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local1="clr-namespace:RunNow.Views"
             mc:Ignorable="d">

    <!-- 🔹 모든 리소스는 여기(앞/뒤)에만 배치 -->
    <UserControl.Resources>
        <conv:RadioCheckedConverter x:Key="RadioCheckedConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 관심산업 그룹핑 리소스 -->
        <CollectionViewSource x:Key="InterestGroups"
                              Source="{Binding InterestCategories}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단 -->
            <RowDefinition Height="*"/>
            <!-- 본문 -->
            <RowDefinition Height="Auto"/>
            <!-- 하단 네비 -->
        </Grid.RowDefinitions>

        <!-- 상단 파란 배경 -->
        <Border Grid.Row="0" Background="#00478F" Padding="0,20">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/LOGO2.png"
                       Width="150" Height="50" Margin="0,0,0,40"/>
            </StackPanel>
        </Border>

        <!-- 본문 카드 -->
        <Border Grid.Row="1" Margin="30,-40,30,10" Padding="20" Background="White" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="Gray"/>
            </Border.Effect>

            <!-- Scroll 영역 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,10">

                    <!-- STEP 1 : 감정 분석 -->
                    <StackPanel Visibility="{Binding IsEmotionStepVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="감정 상태 진단 설문" FontSize="25" FontWeight="Bold" Margin="0,0,0,20"/>
                        <ItemsControl ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox Header="{Binding QuestionText}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="10,5">
                                            <RadioButton Content="전혀 그렇지 않다" GroupName="{Binding Id}"
                                                         IsChecked="{Binding SelectedValue, Mode=TwoWay, Converter={StaticResource RadioCheckedConverter}, ConverterParameter=1}"/>
                                            <RadioButton Content="그렇지 않다" GroupName="{Binding Id}" Margin="10,0,0,0"
                                                         IsChecked="{Binding SelectedValue, Mode=TwoWay, Converter={StaticResource RadioCheckedConverter}, ConverterParameter=2}"/>
                                            <RadioButton Content="보통이다" GroupName="{Binding Id}" Margin="10,0,0,0"
                                                         IsChecked="{Binding SelectedValue, Mode=TwoWay, Converter={StaticResource RadioCheckedConverter}, ConverterParameter=3}"/>
                                            <RadioButton Content="그렇다" GroupName="{Binding Id}" Margin="10,0,0,0"
                                                         IsChecked="{Binding SelectedValue, Mode=TwoWay, Converter={StaticResource RadioCheckedConverter}, ConverterParameter=4}"/>
                                            <RadioButton Content="매우 그렇다" GroupName="{Binding Id}" Margin="10,0,0,0"
                                                         IsChecked="{Binding SelectedValue, Mode=TwoWay, Converter={StaticResource RadioCheckedConverter}, ConverterParameter=5}"/>
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="다음"
                                Command="{Binding GoToFinanceStepCommand}"
                                Background="#00478F" Foreground="White" FontWeight="Bold"
                                Margin="0,20,0,0" Width="400" FontSize="20"/>
                    </StackPanel>

                    <!-- STEP 2 : 재정 분석 -->
                    <StackPanel Visibility="{Binding IsFinanceStepVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500" HorizontalAlignment="Center">

                        <TextBlock Text="총 자산 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="16"/>
                        <TextBox Text="{Binding Assets, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <TextBlock Text="월 수입 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="16"/>
                        <TextBox Text="{Binding Income, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <!-- 고정 지출 -->
                        <TextBlock Text="고정 지출 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="16"/>

                        <TextBlock Text="주거비" Margin="0,10,0,2" FontSize="14"/>
                        <TextBox Text="{Binding Rent, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <TextBlock Text="통신비" Margin="0,10,0,2" FontSize="14"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <TextBlock Text="구독 서비스" Margin="0,10,0,2" FontSize="14"/>
                        <TextBox Text="{Binding Subscription, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <!-- 변동 지출 -->
                        <TextBlock Text="변동 지출 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="16"/>

                        <TextBlock Text="식비" Margin="0,10,0,2" FontSize="14"/>
                        <TextBox Text="{Binding Food, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <TextBlock Text="교통비" Margin="0,10,0,2" FontSize="14"/>
                        <TextBox Text="{Binding Transport, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <TextBlock Text="쇼핑/문화" Margin="0,10,0,2" FontSize="14"/>
                        <TextBox Text="{Binding Leisure, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <!-- 기타 -->
                        <TextBlock Text="월 저축 목표 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="16"/>
                        <TextBox Text="{Binding SavingTarget, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <TextBlock Text="총 부채 (만원)" Margin="0,18,0,5" FontWeight="Bold" FontSize="16"/>
                        <TextBox Text="{Binding Debt, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:NumericInputBehavior.IsNumeric="True" Height="30"/>

                        <Button Content="다음"
                                Command="{Binding GoToCareerStepCommand}"
                                Background="#00478F" Foreground="White" FontWeight="Bold"
                                Margin="0,20,0,0" Width="400" FontSize="20"/>
                    </StackPanel>

                    <!-- STEP 3 : 경력 분석 -->
                    <StackPanel Visibility="{Binding IsCareerStepVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                Width="500" HorizontalAlignment="Center">

                        <TextBlock Text="현재 직무" Margin="0,10,0,5" FontWeight="Bold" FontSize="14"/>
                        <TextBox Text="{Binding CurrentPosition}" Margin="0,0,0,10" FontSize="14"/>

                        <TextBlock Text="경력 연수" Margin="0,10,0,5" FontWeight="Bold" FontSize="14"/>
                        <ComboBox SelectedValue="{Binding SelectedExperience}" SelectedValuePath="Content" Margin="0,0,0,10">
                            <ComboBoxItem Content="1년 미만"/>
                            <ComboBoxItem Content="1~3년"/>
                            <ComboBoxItem Content="3~5년"/>
                            <ComboBoxItem Content="5~10년"/>
                            <ComboBoxItem Content="10년 이상"/>
                        </ComboBox>

                        <TextBlock Text="기술/자격증 (쉼표로 구분)" Margin="0,10,0,5" FontWeight="Bold" FontSize="14"/>
                        <TextBox Text="{Binding Skills}" Margin="0,0,0,10" FontSize="14"/>

                        <!-- 관심 산업 분야 (그룹 헤더 유지) -->
                        <TextBlock Text="관심 산업 분야" Margin="0,10,0,5" FontWeight="Bold" FontSize="14"/>

                        <ItemsControl ItemsSource="{Binding Source={StaticResource InterestGroups}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,10,0,5" FontSize="14"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="5,2" FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="분석하기" Command="{Binding AnalyzeCommand}"
                                Background="#00478F" Foreground="White" FontWeight="Bold"
                                Margin="0,20,0,0" Width="400" FontSize="20"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 하단 고정 네비게이션 -->
        <local1:BottomNav Grid.Row="2"/>

        <!-- ✅ 로딩 오버레이: 항상 화면 정중앙 -->
        <Grid Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
              IsHitTestVisible="True"
              Panel.ZIndex="999">

            <!-- 가운데 셀에 박스를 고정 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="1" Grid.Column="1"
                Background="White" CornerRadius="12" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="260">
                        <ProgressBar IsIndeterminate="True" Height="8" Margin="0,0,0,12"/>

                        <TextBlock Text="분석 중입니다..." 
                           HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,4,0,5"/>
                        <TextBlock Text="잠시만 기다려주세요" 
                           HorizontalAlignment="Center" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
