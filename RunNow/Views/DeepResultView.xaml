<UserControl x:Class="RunNow.Views.DeepResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:views="clr-namespace:RunNow.Views"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 파란 배경 -->
        <Border Grid.Row="0" Background="#00478F" Padding="0,20">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/LOGO2.png"
                       Width="120" Height="40" Stretch="Uniform" Margin="0,0,0,10"/>
                <TextBlock Text="정밀테스트 결과" Foreground="White"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 결과 카드 -->
        <Border Grid.Row="1" Margin="30" Background="White" CornerRadius="20" BorderBrush="Gray" BorderThickness="1" Padding="30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">

                    <TextBlock Text="정밀테스트 결과" FontSize="28" FontWeight="Bold" Margin="0,10,0,20"/>
                    <!-- 결과 요약 -->
                    <TextBlock Text="{Binding ResultText}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <!-- 현실적인 조언 -->
                    <TextBlock Text="현실적인 조언" FontSize="20" FontWeight="Bold" Margin="0,20,0,8"/>

                    <ItemsControl ItemsSource="{Binding RealisticAdvice}" FontSize="16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="•" Margin="0,0,6,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!-- 그래프 제목 -->
                    <TextBlock Text="감정 진단 결과"
                           FontSize="18" FontWeight="Bold" Margin="0,20,0,8"
                           FontFamily="Malgun Gothic"/>

                    <!-- 그래프 -->
                    <lvc:CartesianChart
                    Series="{Binding Series}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    LegendPosition="Top"
                    Width="Auto"
                    Height="300"
                    Margin="0,0,0,0" />


                    <!-- 추천 직무 리스트 -->
                    <TextBlock Text="추천 직무 리스트" FontSize="20" FontWeight="Bold" Margin="0,20,0,8"/>
                    <ItemsControl ItemsSource="{Binding RecommendedJobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="10" Padding="15" Margin="0,0,0,15" Background="#FAFAFA">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Job}" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,8"/>
                                            <TextBlock Text="추천 이유:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="13" Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 하단 네비게이션 -->
        <views:BottomNav Grid.Row="2"/>
    </Grid>
</UserControl>
