<UserControl x:Class="RunNow.Views.ResumeManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RunNow.Views"
             mc:Ignorable="d">
    <Grid Background="#00478F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 타이틀 -->
        <StackPanel Grid.Row="0" Margin="0,30,0,20" HorizontalAlignment="Center">
            <TextBlock Text="이력서 관리 ✈️"
                       FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 내용 -->
        <Border Grid.Row="1" Margin="30,0,30,10" Padding="20" CornerRadius="30" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 프로필 -->
                    <StackPanel HorizontalAlignment="Center">
                        <Ellipse Width="80" Height="80" Stroke="#CCC" StrokeThickness="1" Margin="0,10">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Assets/user.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </StackPanel>

                    <!-- 기본 입력 (박스 없이, 좌우 여백만) -->
                    <StackPanel Margin="20,10,20,10" Orientation="Vertical">
                        <TextBlock Text="이름" FontWeight="Bold" FontSize="17"/>
                        <TextBox Text="{Binding Name}" Margin="0,3,0,10" Height="25" FontSize="17"/>

                        <TextBlock Text="생년월일" FontWeight="Bold" FontSize="17"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="80" Margin="0,0,10,0" FontSize="17"/>
                            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Width="60" Margin="0,0,10,0" FontSize="17"/>
                            <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" Width="60" FontSize="17"/>
                        </StackPanel>

                        <TextBlock Text="E-mail" FontWeight="Bold" FontSize="17"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                            <TextBox Text="{Binding EmailId}" Width="150" Height="25" FontSize="17"/>
                            <TextBlock Text="@" VerticalAlignment="Center" Margin="5,0" FontSize="17"/>
                            <ComboBox ItemsSource="{Binding EmailDomains}" SelectedItem="{Binding SelectedEmailDomain}" Width="150" Height="30" FontSize="17"/>
                        </StackPanel>

                        <TextBlock Text="전화번호" FontWeight="Bold" FontSize="17"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                            <ComboBox ItemsSource="{Binding PhonePrefixes}" SelectedItem="{Binding SelectedPhonePrefix}" Width="70" FontSize="17"/>
                            <TextBlock Text="-" Margin="5,0" FontSize="17"/>
                            <TextBox Text="{Binding PhoneMid}" Width="80" MaxLength="4" FontSize="17"/>
                            <TextBlock Text="-" Margin="5,0" FontSize="17"/>
                            <TextBox Text="{Binding PhoneEnd}" Width="80" MaxLength="4" FontSize="17"/>
                        </StackPanel>

                        <TextBlock Text="주소" FontWeight="Bold" FontSize="17"/>
                        <TextBox Text="{Binding Address}" Margin="0,3,0,10" Height="25" FontSize="17"/>
                    </StackPanel>

                    <!-- 경력사항 -->
                    <Border BorderBrush="#999" BorderThickness="1" CornerRadius="10" Margin="20,20,20,10" MinHeight="150">
                        <StackPanel Margin="10">
                            <TextBlock Text="경력사항" FontWeight="Bold" HorizontalAlignment="Center" FontSize="17"/>
                            <TextBox Text="{Binding Career}" AcceptsReturn="True" Height="80" FontSize="17"/>
                        </StackPanel>
                    </Border>

                    <!-- 자격사항 (검색 + 리스트 통합) -->
                    <Border BorderBrush="#999" BorderThickness="1" CornerRadius="10" Margin="20,10,20,10" MinHeight="150">
                        <StackPanel Margin="10">
                            <TextBlock Text="자격사항" FontWeight="Bold" HorizontalAlignment="Center" FontSize="17"/>

                            <!-- 검색 영역 -->
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedCertificate}"
                                         Height="30"
                                         VerticalAlignment="Center"
                                         FontSize="17"/>
                                <Button Grid.Column="1"
                                        Content="🔍"
                                        Width="34" Height="30" Margin="8,0,0,0"
                                        Command="{Binding OpenCertificateCommand}"
                                        FontSize="17"/>
                            </Grid>

                            <!-- 리스트 -->
                            <Border BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Padding="5">
                                <ListBox ItemsSource="{Binding Certificates}"
                                         MinHeight="80"
                                         FontSize="17"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 한 줄을 좌: 텍스트 / 우: X버튼 으로 분리 -->
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 왼쪽: 자격증 이름 -->
                                                <TextBlock Text="{Binding}"
                                                           VerticalAlignment="Center"
                                                           FontSize="17"
                                                           Margin="0,0,8,0" />

                                                <!-- 오른쪽 끝: X 버튼(삭제) -->
                                                <Button Grid.Column="1"
                                                        Content="❌"
                                                        Command="{Binding DataContext.RemoveCertificateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Width="24" Height="24"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        FontSize="17"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 특이사항 -->
                    <Border BorderBrush="#999" BorderThickness="1" CornerRadius="10" Margin="20,10,20,10" MinHeight="150">
                        <StackPanel Margin="10">
                            <TextBlock Text="특이사항" FontWeight="Bold" HorizontalAlignment="Center" FontSize="17"/>
                            <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="80" FontSize="17"/>
                        </StackPanel>
                    </Border>

                    <!-- 저장 버튼 -->
                    <Button Content="이력서 저장"
                            Background="#00478F"
                            Foreground="White"
                            FontWeight="Bold"
                            Height="40"
                            Margin="20,10,20,20"
                            Command="{Binding SendToServerCommand}"
                            FontSize="17"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 하단 네비 -->
        <local:BottomNav Grid.Row="2"/>
    </Grid>
</UserControl>
