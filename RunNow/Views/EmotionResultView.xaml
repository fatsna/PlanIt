<UserControl x:Class="RunNow.Views.EmotionResultView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:RunNow.Views"
      xmlns:Converter="clr-namespace:RunNow.Converters"
      mc:Ignorable="d"
      FontFamily="Noto sans KR"
      d:DesignHeight="800" d:DesignWidth="760"
      Background="#F2F2F2"
      >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 상단 타이틀 -->
        <TextBlock x:Name="TextBlock_title" Text="감정분석결과"


                   FontFamily="Arial Black"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="#00478F"

                   Background="#F2F2F2"
                   TextAlignment="Center"

                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,27,0,0"
                   Width="400" Height="45"/>

        <Grid Margin="0,70,0,0">
            <Border x:Name="Border_main"
                    Grid.Row="0"
                    BorderBrush="Black"
                    BorderThickness="3"
                    Margin="20"
                    CornerRadius="30"
                    Padding="20">

                <StackPanel>
                    <Grid Height="30" Margin="100,0,100,0">
                        <Border Background="White"
                                BorderBrush="Black"
                                BorderThickness="1"
                                CornerRadius="5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 각 색상 사각형 -->
                                <Rectangle Grid.Column="0" Fill="Red" Width="150" HorizontalAlignment="Left" RadiusX="5" RadiusY="5"/>
                                <Rectangle Grid.Column="1" Fill="Orange" Width="150" HorizontalAlignment="Left" RadiusX="5" RadiusY="5"/>
                                <Rectangle Grid.Column="2" Fill="Gold" Width="150" HorizontalAlignment="Left" RadiusX="5" RadiusY="5"/>
                                <Rectangle Grid.Column="3" Fill="LimeGreen" Width="150" HorizontalAlignment="Left" RadiusX="5" RadiusY="5"/>

                                <!-- 텍스트 레이어: 겹치기 -->
                                <TextBlock Text="극심한"
                                           Grid.Column="0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="17"
                                           Foreground="Black"/>

                                <TextBlock Text="심한"
                                           Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="17"                                           
                                           Foreground="Black"/>

                                <TextBlock Text="보통"
                                           FontSize="17"                                          
                                           Grid.Column="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="Black"/>

                                <TextBlock Text="좋음"
                                           FontSize="17"                                           
                                           Grid.Column="3"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="Black"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Path Stroke="Black"
                          StrokeThickness="2"
                          Data="M 0,10 L 120,10 L 110,0 M 120,10 L 110,20"
                          HorizontalAlignment="Center"
                          Margin="0,10"/>
                    <TextBlock TextWrapping="Wrap" 
                               Margin="0, 10, 0, 0"
                               Height="42" 
                               Width="599"><Run Foreground="SlateGray" 
                                                FontSize="30"
                                                FontWeight="Bold"
                                                Text="     영역"/>
                                            <Run Foreground="SlateGray" 
                                                 FontSize="30" 
                                                 FontWeight="Bold"
                                                 Language="ko-kr" 
                                                 Text="                                   상태"/></TextBlock>

                    <StackPanel Margin="30" HorizontalAlignment="Center" Width="500">
                        <ItemsControl ItemsSource="{Binding EmotionResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300"/>

                                            <!-- 카테고리 -->
                                            <ColumnDefinition Width="*" />
                                            <!-- 막대그래프 -->
                                        </Grid.ColumnDefinitions>

                                        <!-- 카테고리 이름 -->
                                        <TextBlock Text="{Binding Category}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Grid.Column="0" />

                                        <!-- 막대그래프 -->
                                        <Grid Grid.Column="1" Height="18">
                                            <Border Background="White"
                                                    BorderBrush="Black"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <Grid>
                                                    <Rectangle Fill="{Binding BarColor}"
                                                               Converter:BarWidthAnimationBehavior.AnimateTo="{Binding BarWidth}"
                                                               Height="18"
                                                               HorizontalAlignment="Left"  
                                                               RadiusX="5" RadiusY="5"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 진단 메시지 -->
                        <TextBlock Text="진단 메시지"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="SlateGray"
                       Margin="0,20,0,30"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="{Binding RandomDiagnosis}"
                       FontSize="20"
                       TextWrapping="Wrap"
                       Foreground="SlateGray"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Width="450"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 하단 네비게이션 -->
        <local:BottomNav Grid.Row="2"/>
    </Grid>
</UserControl>
