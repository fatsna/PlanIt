<UserControl x:Class="RunNow.Views.EmotionResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RunNow.Views"
             xmlns:conv="clr-namespace:RunNow.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="760">

	<Grid Background="White">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 파도 배경 -->
		<Canvas Grid.Row="0" Grid.RowSpan="2"
                VerticalAlignment="Top"
                Height="530"
                IsHitTestVisible="False"
                Panel.ZIndex="0">
			<Path Fill="#004A91" Stretch="Fill"
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
				<Path.Data>
					<PathGeometry>
						<PathFigure StartPoint="0,0" IsClosed="True">
							<LineSegment Point="0,530" />
							<QuadraticBezierSegment Point1="300,630" Point2="500,530" />
							<QuadraticBezierSegment Point1="700,430" Point2="1000,530" />
							<LineSegment Point="1000,0" />
						</PathFigure>
					</PathGeometry>
				</Path.Data>
			</Path>
		</Canvas>

		<!-- 상단 헤더 -->
		<Border Grid.Row="0" Background="Transparent" Padding="0,20" Panel.ZIndex="1">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
				<TextBlock Text="감정 분석 결과"
                           FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>

		<!-- 카드 박스 -->
		<Border Grid.Row="1" Margin="40,0,40,30" Padding="20"
                Background="White" CornerRadius="20" Panel.ZIndex="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="10" ShadowDepth="3" Color="Gray"/>
			</Border.Effect>

			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Width="520" HorizontalAlignment="Center">

					<!-- 범례 바 (파스텔톤으로 연하게) -->
					<Grid Height="40" Margin="0,60,0,8">
						<Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<!-- Pastel colors -->
								<Rectangle Grid.Column="0" Fill="#EF5350" RadiusX="8" RadiusY="8"/>
								<Rectangle Grid.Column="1" Fill="#FFA726" RadiusX="8" RadiusY="8"/>
								<Rectangle Grid.Column="2" Fill="#FFCA28" RadiusX="8" RadiusY="8"/>
								<Rectangle Grid.Column="3" Fill="#66BB6A" RadiusX="8" RadiusY="8"/>


								<TextBlock Grid.Column="0" Text="극심한"
                                           FontSize="15" FontWeight="Bold" Foreground="#222"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="심한"
                                           FontSize="15" FontWeight="Bold" Foreground="#222"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="2" Text="보통"
                                           FontSize="15" FontWeight="Bold" Foreground="#222"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="3" Text="좋음"
                                           FontSize="15" FontWeight="Bold" Foreground="#222"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Grid>
						</Border>
					</Grid>

					<Separator Margin="0,6,0,12"/>

					<!-- 카테고리별 결과 막대 -->
					<ItemsControl ItemsSource="{Binding EmotionResults}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,18">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="240"/>
										<!-- 카테고리 -->
										<ColumnDefinition Width="*"/>
										<!-- 막대 -->
									</Grid.ColumnDefinitions>

									<!-- 카테고리 이름 -->
									<TextBlock Text="{Binding Category}"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Grid.Column="0"/>

									<!-- 막대그래프 -->
									<Grid Grid.Column="1" Height="22" VerticalAlignment="Center">
										<Border Background="White"
                                                BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="7">
											<Grid>
												<Rectangle Fill="{Binding BarColor}"
                                                           Opacity="0.85"
                                                           conv:BarWidthAnimationBehavior.AnimateTo="{Binding BarWidth}"
                                                           Height="22"
                                                           HorizontalAlignment="Left"
                                                           RadiusX="7" RadiusY="7"/>
											</Grid>
										</Border>
									</Grid>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- 여백 -->
					<Border Height="10" Background="Transparent"/>

					<!-- 진단 메시지 -->
					<TextBlock Text="진단 메시지"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#444" Margin="0,10,0,6"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding RandomDiagnosis}"
                               FontSize="18" TextWrapping="Wrap"
                               Foreground="#444"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Width="480"/>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- 하단 고정 네비게이션 -->
		<local:BottomNav Grid.Row="2" Panel.ZIndex="1"/>
	</Grid>
</UserControl>