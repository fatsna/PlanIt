<UserControl x:Class="RunNow.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:views="clr-namespace:RunNow.Views">
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단 헤더 -->
            <RowDefinition Height="*"/>
            <!-- 본문(지도) -->
            <RowDefinition Height="Auto"/>
            <!-- 하단 네비 -->
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="#00478F" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="지도" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 본문: Kakao Map -->
        <Border Grid.Row="1" Margin="20" Padding="0" CornerRadius="16" Background="White"
                BorderBrush="#D9D9D9" BorderThickness="1">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>

        <!-- 하단 네비 (이미 프로젝트에 있는 컴포넌트) -->
        <views:BottomNav Grid.Row="2"/>
    </Grid>
</UserControl>
