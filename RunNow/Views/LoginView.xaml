<UserControl x:Class="RunNow.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:RunNow.Core"
      xmlns:conv="clr-namespace:RunNow.Converters">

    <UserControl.Resources>
        <!-- Boolean -> Visibility 변환 -->
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 버튼 스타일 (디자인 유지) -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- Background Curve -->
        <Canvas VerticalAlignment="Top" Height="530" Panel.ZIndex="0">
            <Path Fill="#004A91" Stretch="Fill"
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="0,530" />
                            <QuadraticBezierSegment Point1="300,630" Point2="500,530" />
                            <QuadraticBezierSegment Point1="700,430" Point2="1000,530" />
                            <LineSegment Point="1000,0" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- Logo -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Image Source="/Assets/logo.png" Width="300" Height="300" />
        </StackPanel>

        <!-- Login Box -->
        <Border Background="White"
                CornerRadius="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,100,0,0"
                Width="420"
                Height="480"
                Padding="25"
                Panel.ZIndex="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="5" Color="Gray" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="아이디" Margin="0,10,0,6" FontSize="16"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40"/>

                <TextBlock Text="비밀번호" Margin="0,14,0,6" FontSize="16"/>
                <PasswordBox local:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" Height="40"/>

                <!-- Main Buttons -->
                <StackPanel Margin="0,20,0,0">
                    <Button Content="얼굴인식"
                            Height="50"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="#007ACC"
                            Foreground="White"
                            Command="{Binding FaceLoginCommand}"/>

                    <Button Content="로그인"
                            Height="60"
                            Margin="0,10,0,0"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="#004A91"
                            Foreground="White"
                            Command="{Binding LoginCommand}"/>
                </StackPanel>

                <!-- Extra options -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Margin="0,0,20,0" Foreground="Gray" Cursor="Hand">
                        <Hyperlink Command="{Binding NavigateRegisterCommand}">
                            회원가입
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Foreground="Gray" Cursor="Hand">
                        <Hyperlink Command="{Binding FindPasswordCommand}">
                            비밀번호 찾기
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 얼굴 인식 팝업 -->
        <Border Visibility="{Binding IsFacePopupVisible, Converter={StaticResource BoolToVis}}"
                Background="#DDFFFFFF"
                CornerRadius="10"
                Width="220"
                Height="80"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Panel.ZIndex="99">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <Image Source="{Binding FacePopupImagePath}" Width="40" Height="40" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding FacePopupText}" VerticalAlignment="Center" FontSize="16" Foreground="Black"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
