<UserControl x:Class="RunNow.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RunNow.Views"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="500">

    <Grid Background="White">
        <!-- ✅ 로그인 버튼 커스텀 스타일
             - 초기/비활성화: Aqua Blue (#00BCD4)
             - 활성화(CanLogin=True): 남색(#004A91)
             - 하얀 빈칸 방지용 ControlTemplate 포함 -->
        <Grid.Resources>
            <Style x:Key="LoginButtonStyle" TargetType="Button">
                <!-- 기본(초기) 색은 Aqua. 활성화 되면 DataTrigger로 바뀜 -->
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#00BCD4"/>
                <!-- Aqua Blue -->
                <Setter Property="BorderBrush" Value="#00BCD4"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 비활성화(클릭 불가): Aqua 유지 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#00BCD4"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00BCD4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                                <!-- 호버/클릭 (활성화 시에만 체감) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0A5FBF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#0A5FBF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#084C96"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#084C96"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!-- ✅ 로그인 가능 상태(CanLogin=True)면 즉시 남색으로 -->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanLogin}" Value="True">
                        <Setter Property="Background" Value="#004A91"/>
                        <Setter Property="BorderBrush" Value="#004A91"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <!-- 배경 영역 -->
        <Canvas VerticalAlignment="Top" Height="530" Panel.ZIndex="0">
            <Path Fill="#004A91" Stretch="Fill"
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="0,0" IsClosed="True">
                            <LineSegment Point="0,530" />
                            <QuadraticBezierSegment Point1="300,630" Point2="500,530" />
                            <QuadraticBezierSegment Point1="700,430" Point2="1000,530" />
                            <LineSegment Point="1000,0" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>

        <!-- 로고 -->
        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
            <Image Source="/Assets/logo.png" Width="300" Height="300" />
        </StackPanel>

        <!-- 로그인 박스 -->
        <Border Background="White"
                CornerRadius="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,100,0,0"
                Width="450"
                Height="480"
                Padding="25"
                Panel.ZIndex="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="5" Color="Gray" />
            </Border.Effect>

            <StackPanel>

                <!-- 아이디 -->
                <TextBlock Text="아이디" Margin="0,42,0,6" FontSize="20"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontSize="17"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Left"/>

                <!-- 비밀번호 -->
                <TextBlock Text="비밀번호" Margin="0,15,0,6" FontSize="20"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             FontSize="17"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"/>

                <!-- 버튼 -->
                <StackPanel Margin="0,20,0,0">
                    <Button Content="얼굴인식"
                            Height="50"
                            Background="#007ACC"
                            Foreground="White"

                            Click="FaceRecognition_Click" FontSize="18"/>


                    <!-- 로그인: 스타일만 적용 -->
                    <Button Content="로그인"
                            Height="50"
                            Margin="0,10,0,0"
                            Background="#004A91"
                            Foreground="White"
                            Command="{Binding LoginCommand}" FontSize="18"/>

                </StackPanel>

                <!-- 회원가입 / 비밀번호찾기 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="회원가입"
                               Foreground="Gray"
                               Margin="0,0,20,0"
                               Cursor="Hand"
                               MouseLeftButtonDown="Register_Click" FontSize="16"/>
                    <TextBlock Text="비밀번호 찾기"
                               Foreground="Gray"
                               Cursor="Hand"
                               MouseLeftButtonDown="FindPassword_Click" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 얼굴 인식 팝업 영역 -->
        <Border x:Name="FacePopup"
                Visibility="Collapsed"
                Background="#DDFFFFFF"
                CornerRadius="16"
                Width="200"
                Height="200"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,30,0,0"
                Panel.ZIndex="99">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PopupImage" Width="80" Height="80" Margin="0,10,0,10"/>
                <TextBlock x:Name="PopupText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="Black"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
