<UserControl x:Class="RunNow.Views.growth_start_View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RunNow.Views"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:lowbar="clr-namespace:RunNow.Views"
    mc:Ignorable="d"
    d:DesignHeight="1000" d:DesignWidth="760"
    Background="White"
    FontFamily="Noto Sans KR">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 공통: 원형 아이콘 버튼 스타일 -->
        <Grid.Resources>
            <Style x:Key="CircularIconButton" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="bg" CornerRadius="22"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#F5F8FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#E7EFFD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- 상단 영역 전체 (배경/헤더/카드) -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 헤더 -->
                <RowDefinition Height="*"/>
                <!-- 카드 -->
            </Grid.RowDefinitions>

            <!-- 파도 배경: 헤더+카드 뒤로 깔기 -->
            <Canvas Grid.Row="0" Grid.RowSpan="2"
                    VerticalAlignment="Top" Height="530"
                    Panel.ZIndex="0" IsHitTestVisible="False">
                <Path Fill="#004A91" Stretch="Fill"
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,0" IsClosed="True">
                                <LineSegment Point="0,530"/>
                                <QuadraticBezierSegment Point1="300,630" Point2="500,530"/>
                                <QuadraticBezierSegment Point1="700,430" Point2="1000,530"/>
                                <LineSegment Point="1000,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <!-- 헤더: 뒤로가기 + 중앙 타이틀 (맨 위 고정) -->
            <Border Grid.Row="0" Background="Transparent" Padding="16,18" Panel.ZIndex="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 뒤로가기 -->
                    <Button Style="{StaticResource CircularIconButton}"
                            Command="{Binding BackCommand}">
                        <TextBlock Text="←" FontSize="18"/>
                    </Button>

                    <!-- 중앙 타이틀: 항상 정중앙 -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                               Text="성장플래닛"
                               FontSize="30" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 메인 카드: 헤더 아래로 내림 -->
            <Border Grid.Row="1"
                    Margin="20,30,20,20"
                    Padding="28"
                    MinHeight="650"
                    CornerRadius="30" Background="White"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="5" Color="Gray"/>
                </Border.Effect>

                <!-- 카드 내부 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 검색 -->
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <!-- 2컬럼 본문 -->
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <!-- 하단 버튼 -->
                    </Grid.RowDefinitions>

                    <!-- 검색 박스 -->
                    <Border Grid.Row="0" CornerRadius="50" Background="White"
                            BorderBrush="#D0D7E2" BorderThickness="1" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TextBox_job"
                                     Text="{Binding SerchJob, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="18"
                                     BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     Foreground="Black" ToolTip="직업을 입력하세요">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="GotFocus">
                                        <i:InvokeCommandAction Command="{Binding ClearTextCommand}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>

                            <!-- 검색 버튼 -->
                            <Button Grid.Column="1" Margin="10,0,0,0"
                                    Style="{StaticResource CircularIconButton}"
                                    Command="{Binding Serch_to_severCommand}">
                                <TextBlock Text="🔍" FontSize="18"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 본문 2컬럼 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌: 추천 직업 리스트 -->
                        <Border x:Name="Border_main"
                                Grid.Column="0"
                                Background="White"
                                BorderBrush="#D0D7E2" BorderThickness="1"
                                CornerRadius="20" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="8" Opacity="0.35"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Jobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Margin="0,6,8,0"
                                                    Width="240" Height="44"
                                                    FontSize="14"
                                                    Style="{StaticResource ButtonStyleRound}"
                                                    Command="{Binding DataContext.SelectJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Index}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- 우: 직업 설명 / 추천 이유 (파랑 톤) -->
                        <Border x:Name="Border_job"
                                Grid.Column="2"
                                Background="White"
                                BorderBrush="#D0D7E2" BorderThickness="1"
                                CornerRadius="20" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" ShadowDepth="3" BlurRadius="8" Opacity="0.35"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="직업 설명"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="#004A91" Margin="0,0,0,8"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <Border Background="#F3F8FF" BorderBrush="#CCE0FF" BorderThickness="1"
                                            CornerRadius="12" Padding="12">
                                        <TextBlock Text="{Binding DataContext.SelectedJobExplain, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="16" Foreground="#1F2937" TextWrapping="Wrap"/>
                                    </Border>
                                </ScrollViewer>

                                <TextBlock Grid.Row="2" Text="추천 이유"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="#004A91" Margin="0,12,0,8"/>

                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <Border Background="#F3F8FF" BorderBrush="#CCE0FF" BorderThickness="1"
                                            CornerRadius="12" Padding="12">
                                        <TextBlock Text="{Binding DataContext.SelectedJobReson, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontSize="16" Foreground="#1F2937" TextWrapping="Wrap"/>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 카드 하단: 플래닛 만들기 버튼 -->
                    <Button x:Name="Button_make_planit"
                            Grid.Row="4"
                            Height="72"
                            Command="{Binding Make_PlanITCommand}"
                            Background="#004A91" Foreground="White"
                            Content="{Binding Wantjobtext}"
                            FontSize="24" FontWeight="Bold"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Gray"/>
                        </Button.Effect>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 오버레이(캘린더) - 화면 위에 덮기 -->
        <Grid x:Name="Grid_calendar"
              Grid.Row="0"
              Panel.ZIndex="100"
              Visibility="{Binding shareDataService.IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectangleClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>

            <local:messageback x:Name="messageback"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Background="Transparent"
                               Padding="20">
                <local:messageback.LayoutTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                </local:messageback.LayoutTransform>
            </local:messageback>
        </Grid>

        <!-- 하단 네비 -->
        <lowbar:BottomNav Grid.Row="1"/>
    </Grid>
</UserControl>
