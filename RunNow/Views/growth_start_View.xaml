<UserControl x:Class="RunNow.Views.growth_start_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RunNow.Views"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="760"
      Background="White"
      xmlns:lowbar="clr-namespace:RunNow.Views"
      FontFamily="Noto sans KR"
      >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 상단 타이틀 -->
        <Image Source="/Assets/뒤로가기파랑.drawio.png"
                     HorizontalAlignment="Left"
                     Margin="10,10,0,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding BackCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Image>
        <TextBlock x:Name="TextBlock_title" Text="성장플래닛"
                   FontFamily="Noto sans KR"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="SlateGray"
                   Background="White"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   Width="400" Height="60"/>
        <Image Source="/Assets/sendblue.png"
                     HorizontalAlignment="Right"
                     Margin="10,10,30,0"
                     VerticalAlignment="Top"
                     Width="80"
                     Height="80"
                     Grid.Row="0"
                     Grid.Column="0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <!--무언가 커맨드해서 기능추가가능-->
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Image>
        <Grid x:Name="Grid_job"
              Background="#00478F"
              Margin="0, 100, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 직업 리스트 영역 모델프로퍼티가 데이터를 받으면 받은데이터를 바인딩해서 ui에 표현-->
            <Border x:Name="Border_main"
                    Grid.Row="0"
                    Grid.Column= "0"
                    Background="white"
                    BorderBrush="Black"
                    BorderThickness="3"
                    Margin="30, -100, 30, -70"
                    Height="500"
                    CornerRadius="30"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect
                        Color="Black" ShadowDepth="5" BlurRadius="10" Opacity="0.5">
                    </DropShadowEffect>
                </Border.Effect>
                <ScrollViewer>
                    <!--서버에서 받은 추천직종, 희망직종 UI로 만들기-->
                    <ItemsControl ItemsSource="{Binding Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Margin="0, 5, 10, 0"
                                        Width="200"
                                        Height="40"
                                        FontSize="14"
                                        Style="{StaticResource ButtonStyleRound}"
                                        Command="{Binding DataContext.SelectJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Index}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <!-- 직업 설명? 서버에 받아오기-->
            <Border x:Name="Border_job"
                    Grid.Column="1"
                    Grid.Row="0"
                    Background="white"
                    Height="500"
                    BorderBrush="Black"
                    BorderThickness="3"
                    Margin="30, -100, 30, -70"
                    CornerRadius="30"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect
                         Color="Black" ShadowDepth="5" BlurRadius="10" Opacity="0.5">
                    </DropShadowEffect>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="직업 설명"
                               FontSize="25"
                               TextAlignment="Center"
                               Foreground="#FE885C"
                               Margin="0, -10, 0, 5"/>
                    <!--직업설명 바인딩-->
                    <TextBlock Text="{Binding DataContext.SelectedJobExplain, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Grid.Row="1"
                               FontSize="20"
                               Foreground="Black"
                               Background="LightYellow"
                               TextWrapping="Wrap"
                               Margin="0"
                               >
                    <!--직업추천 이유-->
                    </TextBlock>
                    <TextBlock Text="추천 이유"
                               Grid.Row="2"
                               FontSize="25"
                               TextAlignment="Center"
                               Foreground="#FE885C"
                               Margin="0, 5, 0, 5"/>
                    <!--직업추천 바인딩-->
                    <TextBlock Text="{Binding DataContext.SelectedJobReson, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Grid.Row="3"
                               FontSize="20"
                               Foreground="Black"
                               Background="LightYellow"
                               TextWrapping="Wrap"
                               Margin="0"
                               />
                </Grid>
            </Border>
        </Grid>
        <Grid Margin="0, 700, 0, 0">
            <!-- 플래닛 만들기 버튼 -->
            <Button x:Name="Button_make_planit"
                Grid.Row="2"           
                    Width="700"
                    Height="80"
                    Command="{Binding Make_PlanITCommand}"
                    Background="#B0C4DE"
                    Foreground="Black"                    
                    Content="{Binding Wantjobtext}"
                    FontSize="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource FlatButtonStyle}">
            </Button>
        </Grid>
        <!-- 하단 네비게이션 -->
        <lowbar:BottomNav Grid.Row="2"/>
        <Grid>
            <Border Margin="40,-530,40, 0"
                    Background="White"
                    Width="650"
                    Height="70"                    
                    BorderBrush ="SlateGray"                 
                    CornerRadius="50"
                    >
                <Border.Effect>
                    <DropShadowEffect
                        Color="Black" ShadowDepth="5" BlurRadius="10" Opacity="0.5">
                    </DropShadowEffect>
                </Border.Effect>

                <TextBox x:Name="TextBox_job"
                        Width="700"
                        Height="80"
                        Text="{Binding SerchJob, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Top"
                        Foreground="Black"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontSize="20">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                         <i:InvokeCommandAction Command="{Binding ClearTextCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                </TextBox>
            </Border>
            <Image Source="/Assets/돋보기.drawio.png"
                     HorizontalAlignment="Left"
                     Margin="629,125,0,0"
                     VerticalAlignment="Top"
                     Width="60"
                     Height="60"
                     Grid.Row="0"
                     Grid.Column="0" RenderTransformOrigin="1.84,0.48">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <!--무언가 커맨드해서 기능추가가능-->
                        <i:InvokeCommandAction Command="{Binding Serch_to_severCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Image>
        </Grid>
        <!--두번쨰 레이아웃-->
        <Grid   x:Name="Grid_calendar"
            Visibility="{Binding shareDataService.IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 어두운 배경 -->
            <Rectangle Fill="#80000000">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding RectangleClickCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Rectangle>
            <local:messageback x:Name="messageback"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0, 0, 0, 0"
                Background="Transparent"
                Padding="20"/>
        </Grid>
    </Grid>
</UserControl>
